//@version=6
strategy("TL Rejections - MTF", shorttitle="TLS", overlay=true,
         max_lines_count=500, max_boxes_count=500, max_labels_count=500,
         initial_capital=1000000, currency=currency.USD,
         default_qty_type=strategy.fixed, default_qty_value=1,
         process_orders_on_close=true)
// NOTA: max_lines_count=500 es el MAXIMO permitido por Pine v6.
// Cuando se excede, TV purga lineas viejas silenciosamente.
// Por eso hay safety code que recrea TL/BK lines cada barra si fueron purgadas.

// =============================================================================
// INPUTS
// =============================================================================
// =============================================================================
// PARAMETROS ESTADISTICOS DE TRENDLINES Y BREAKS (FIJOS - NO CONFIGURABLES)
// Estos valores son resultado de literatura experta de price action y se
// adaptan automaticamente al timeframe del chart (5m, 1H, 1D, etc.).
// Si necesitas cambiar alguno, edita el codigo directamente.
// =============================================================================

// Detectar segundos por barra del timeframe actual (usado para adaptar parametros)
int   _curTfSec = timeframe.in_seconds(timeframe.period)

// --- Deteccion de pivotes y best-fit de TL ---
int   i_pivPer     = 10        // barras a cada lado para confirmar pivote estructural
// i_nPiv (cuantos pivotes evalua el best-fit) se define abajo dinamicamente igual al tamano del buffer
// minTouches: 2 toques en cualquier TF (relajado para aumentar frecuencia de entradas)
// Antes era 3 en TFs bajos lo cual era muy estricto en intraday
int   i_minTouches = 2
float i_atrMult    = 0.5       // tolerancia de toque en xATR (apretada de 0.7 a 0.5 para entrar mas pegado a la linea)
float i_wickRatio  = 0.15      // wick minimo del rango (relajado de 0.25 para mas rechazos validos)
// minSpacing adaptado: en TFs altos las distancias entre toques son mas grandes
// 5m-30m: 20 barras (~100min en 5m)
// 30m-4H: 10 barras
// 4H+:    5 barras (en daily 5 dias entre toques es razonable)
int   i_minSpacing = _curTfSec >= 14400 ? 5 : (_curTfSec >= 1800 ? 10 : 20)

// --- Mejoras expertas (Linda Raschke / Edwards-Magee / Bulkowski) ---
bool  i_useRecencyBias     = true   // pivotes recientes pesan mas (regimen actual)
float i_recencyDecay       = 0.99   // decay suave por barra de antiguedad
float i_maxSlopeATR        = 0.5    // rechaza TLs con pendiente >0.5 ATR/barra (parabolicas)
bool  i_useBodyPivots      = false  // en XAUUSD wicks suelen ser estructura real
bool  i_forceExtremeAnchor = true   // alinea con lectura visual del trader
bool  i_applyFatigue       = true   // niveles >=7 toques pierden score (Raschke)

// --- Spread / break detection (TL rota -> BK) ---
float i_minSpreadATR  = 2.0     // filtro secundario consolidacion para senales BK
// i_bkConfirmBars adaptado por timeframe: en TFs altos (4H+) un solo cierre es decisivo.
// 5m-30m: 3 barras (filtro estricto contra Judas)
// 30m-4H: 2 barras
// 4H+:    1 barra (un cierre decisivo en daily/4H ya es break)
int   i_bkConfirmBars = _curTfSec >= 14400 ? 1 : (_curTfSec >= 1800 ? 2 : 3)
float i_bkMinATR      = 0.3     // distancia min cierre vs TL para contar barra de break
float i_bkDupATR      = 0.5     // si nueva BK proyecta dentro de N*ATR de actual = duplicado
// Ventana Judas adaptada por timeframe (mas barras en TFs bajos, menos en altos)
// 5m-30m: 8 barras (40-240min de vigilancia)
// 30m-4H: 4 barras
// 4H+:    2 barras (en daily 2 dias es suficiente para detectar fakeout)
int   i_bkJudasBars   = _curTfSec >= 14400 ? 2 : (_curTfSec >= 1800 ? 4 : 8)
float i_bkJudasATR    = 0.3     // distancia retorno que invalida BK como Judas
// bkMinTouches: igual que minTouches (2 toques minimo)
int   i_bkMinTouches  = 2
// Vol filter solo en TFs bajos. En daily/4H, tick volume puede ser menos representativo
// y los breakouts validos pueden no siempre tener spike de volumen suficiente.
bool  i_useVolFilter  = _curTfSec < 14400
float i_volMult       = 1.2     // multiplicador del volumen vs promedio
// Body filter solo en TFs bajos (5m-1H). En 4H+ los breaks suelen ser velas
// explosivas que abren bajo la TL y cierran muy por encima; el body filter
// rechazaria estos breakouts validos. En daily/4H confiamos solo en el cierre.
bool  i_useBodyBreak  = _curTfSec < 14400
int   i_bkMaxTouches  = 2       // BK muere tras N aproximaciones fisicas (Raschke: niveles agotados tras 2-3 tests)
float i_minPromATR    = 2.0     // pivote debe sobresalir >= N x ATR sobre suma de sus 20 vecinos (filtra consolidaciones)

// --- Confluencia HTF (FIJOS) ---
string i_htf1TF     = "60"      // H1 (timeframe medio)
int    i_htf1Period = 5         // periodo pivote en H1
string i_htf2TF     = "240"     // H4 (timeframe alto)
int    i_htf2Period = 5         // periodo pivote en H4
float  i_htfTol     = 1.5       // tolerancia confluencia en xATR
int    i_minScore   = 0         // score minimo entrada (0 = sin filtro adicional)
float  i_htfRoomMinATR = 3.0    // distancia minima al siguiente HTF level para sumar "room to run"

var GRP_SES = "Sesiones"
// Sesiones globales fijas en UTC (no editables - son los horarios reales del mercado)
// Asia (Tokio): 0-7 UTC | London: 7-12 UTC | NY: 12-17 UTC
int ASIA_START_UTC = 0
int ASIA_END_UTC   = 7
int LD_START_UTC   = 7
int LD_END_UTC     = 12
int NY_START_UTC   = 12
int NY_END_UTC     = 17

i_showSesLbl = input.bool(true, "Etiquetas de sesion", group=GRP_SES)
i_filterSes  = input.string("LD+NY", "Sesion para senales",
               options=["Todas", "LD", "NY", "LD+NY"], group=GRP_SES)

// Horario operativo en hora LOCAL del usuario.
// NOTA: Pine Script no puede leer el timezone seleccionado en TradingView (es client-side).
// Si configuras tu UTC offset aqui, debe coincidir con el de TradingView (esquina inferior derecha).
i_userUtcOffset = input.int(-6, "Tu UTC offset (debe coincidir con TradingView)", minval=-12, maxval=14, group=GRP_SES,
               tooltip="Mexico=-6 | Colombia/Peru=-5 | Venezuela/Bolivia=-4 | Argentina/Chile/Brasil=-3. Si TradingView muestra UTC-6 abajo a la derecha, dejas -6.")
i_tradeStart = input.int(7,  "Horario operativo - Inicio (hora local)", minval=0, maxval=23, group=GRP_SES,
               tooltip="Hora LOCAL en tu timezone (no UTC). Por defecto 7am.")
i_tradeEnd   = input.int(11, "Horario operativo - Fin    (hora local)", minval=0, maxval=23, group=GRP_SES,
               tooltip="Hora LOCAL en tu timezone. Por defecto 11am.")
i_showTradeHrs = input.bool(true, "Lineas verticales en horario operativo", group=GRP_SES,
               tooltip="Dibuja una linea blanca segmentada al inicio y al fin de tu ventana operativa diaria.")

var GRP_RISK = "Gestion de Riesgo"
i_riskUSD    = input.float(60.0, "Riesgo fijo por operacion (USD)", minval=1.0, step=5.0, group=GRP_RISK,
               tooltip="Cuanto estas dispuesto a perder en un trade que toca SL. La cantidad de unidades se calcula automaticamente para que la perdida = este valor.")
i_backtesting = input.bool(false, "Mostrar etiquetas debug", group=GRP_RISK,
               tooltip="Activa labels de debug para ver el estado interno del algoritmo en cada barra (contadores, scores, condiciones de senal). Solo para investigacion.")

var GRP_ALGO = "Algoritmo (avanzado)"
i_pivBuffer = input.int(10, "History TLA/TLB", minval=5, maxval=50, group=GRP_ALGO,
              tooltip="Cuantos pivotes recientes recuerda el algoritmo para construir TLA (soporte) y TLB (resistencia). Mas grande = mas historia disponible (mejor para detectar TLs antiguas relevantes), pero mayor costo computacional y posibles TLs muy antiguas que ya no aplican. Default 10 = buen balance.")
int i_nPiv = i_pivBuffer       // cuantos pivotes evalua el best-fit (igual al tamano del buffer)

// --- Algoritmo de gestion de riesgo (FIJOS) ---
float i_slBuf        = 0.3      // SL buffer en xATR sobre el pivote
bool  i_useStructTP  = true     // TP en siguiente nivel estructural (fallback 1:2)
float i_minStructRR  = 1.0      // R/R minimo para aceptar TP estructural (cualquier estructura por encima de entrada+slDist)
float i_tpStructBuf  = 0.5      // buffer en xATR antes del nivel estructural
float i_maxTpAtr     = 4.0      // Cap de distancia maxima de TP en xATR (evita HTF lejanos absurdos)
float i_minRRentry   = 1.2      // R/R minimo para tomar el trade. Si TP_real/SL_real < esto, se cancela la entrada

var GRP_VIS = "Visual"
// Paleta holograma neon: violeta -> azul -> cyan, sin tonos calientes
i_colH    = input.color(#00E5FF, "Color resistencia (B)",  group=GRP_VIS)
i_colL    = input.color(#B388FF, "Color soporte (A)",     group=GRP_VIS)
i_colBK   = input.color(#FF4081, "Color break (BK)",      group=GRP_VIS)
i_colAsia = input.color(color.new(color.white, 90), "Asia fondo", group=GRP_VIS)
i_colLD   = input.color(color.new(#9B59B6, 87),     "LD fondo",   group=GRP_VIS)
i_colNY    = input.color(color.new(#00EFEF, 90),     "NY fondo",        group=GRP_VIS)
// HTF1 (1H) - tonos magenta/purpura, distintos de los locales
i_colHTF1H = input.color(color.new(#E040FB,  0),    "HTF1 resistencia (1H)", group=GRP_VIS)
i_colHTF1L = input.color(color.new(#BA68C8,  0),    "HTF1 soporte (1H)",     group=GRP_VIS)
// HTF2 (4H) - tonos azul indigo (mas profundos = TF mas alta)
i_colHTF2H = input.color(color.new(#536DFE,  0),    "HTF2 resistencia (4H)", group=GRP_VIS)
i_colHTF2L = input.color(color.new(#03A9F4,  0),    "HTF2 soporte (4H)",     group=GRP_VIS)

// =============================================================================
// SESIONES
// =============================================================================
int _utcH      = math.floor(time / 3600000) % 24
// Hora local del usuario calculada desde UTC + offset (manejo correcto de negativos)
int _localHour = ((_utcH + i_userUtcOffset) % 24 + 24) % 24

f_inSes(int s, int e) =>
    (s < e ? (_utcH >= s and _utcH < e) : (_utcH >= s or _utcH < e))

bool _inAsia = f_inSes(ASIA_START_UTC, ASIA_END_UTC)
bool _inLD   = f_inSes(LD_START_UTC,   LD_END_UTC)
bool _inNY   = f_inSes(NY_START_UTC,   NY_END_UTC)

bool _asiaOpen = _inAsia and not _inAsia[1]
bool _ldOpen   = _inLD   and not _inLD[1]
bool _nyOpen   = _inNY   and not _inNY[1]

var float _asiaH = float(na), var float _asiaL = float(na)
var float _ldH   = float(na), var float _ldL   = float(na)
var float _nyH   = float(na), var float _nyL   = float(na)

if _asiaOpen
    _asiaH := high
    _asiaL := low
if _inAsia
    _asiaH := math.max(_asiaH, high)
    _asiaL := math.min(_asiaL, low)

if _ldOpen
    _ldH := high
    _ldL := low
if _inLD
    _ldH := math.max(_ldH, high)
    _ldL := math.min(_ldL, low)

if _nyOpen
    _nyH := high
    _nyL := low
if _inNY
    _nyH := math.max(_nyH, high)
    _nyL := math.min(_nyL, low)

var box _bAsia = na
var box _bLD   = na
var box _bNY   = na

if _asiaOpen
    _bAsia := box.new(bar_index, high, bar_index, low,
                      border_color=color.new(color.white, 75), bgcolor=i_colAsia)
if _inAsia and not na(_bAsia)
    box.set_right(_bAsia,  bar_index)
    box.set_top(_bAsia,    _asiaH)
    box.set_bottom(_bAsia, _asiaL)

if _ldOpen
    _bLD := box.new(bar_index, high, bar_index, low,
                    border_color=color.new(#9B59B6, 55), bgcolor=i_colLD)
if _inLD and not na(_bLD)
    box.set_right(_bLD,  bar_index)
    box.set_top(_bLD,    _ldH)
    box.set_bottom(_bLD, _ldL)

if _nyOpen
    _bNY := box.new(bar_index, high, bar_index, low,
                    border_color=color.new(#00AAAA, 55), bgcolor=i_colNY)
if _inNY and not na(_bNY)
    box.set_right(_bNY,  bar_index)
    box.set_top(_bNY,    _nyH)
    box.set_bottom(_bNY, _nyL)

if i_showSesLbl
    if _asiaOpen
        label _la = label.new(bar_index, high, "Asia", style=label.style_label_down,
                     color=color.new(color.white, 60), textcolor=color.gray, size=size.tiny)
    if _ldOpen
        label _ll = label.new(bar_index, high, "LD", style=label.style_label_down,
                     color=color.new(#9B59B6, 40), textcolor=color.white, size=size.tiny)
    if _nyOpen
        label _ln = label.new(bar_index, high, "NY", style=label.style_label_down,
                     color=color.new(#00AAAA, 40), textcolor=color.white, size=size.tiny)

bool _sesOK       = switch i_filterSes
    "LD"    => _inLD
    "NY"    => _inNY
    "LD+NY" => _inLD or _inNY
    =>         true
// Trading hours en hora LOCAL del usuario (definida por i_userUtcOffset)
bool _inTradeHours = _localHour >= i_tradeStart and _localHour < i_tradeEnd

// =============================================================================
// PIVOTES Y TRENDLINES (best-fit, igual que trendlines.pine)
// =============================================================================
float atrVal = ta.atr(14)
float _tol   = atrVal * i_atrMult

// Lineas verticales blancas segmentadas marcando inicio/fin de horario operativo.
// FIX line accumulation: usa buffer circular de 10 lineas (5 dias x 2 lines/dia).
// Asi no se acumulan indefinidamente y comen el limite max_lines_count=500.
var line[] _hrLines = array.new<line>(0)
int _hrMaxLines = 10

if i_showTradeHrs
    bool _hrStart = _inTradeHours and not _inTradeHours[1]
    bool _hrEnd   = not _inTradeHours and _inTradeHours[1]
    if _hrStart or _hrEnd
        float _hrTop = ta.highest(high, 500) + atrVal * 5
        float _hrBot = ta.lowest(low, 500) - atrVal * 5
        line _newHrLine = line.new(bar_index, _hrBot, bar_index, _hrTop,
                                    color=color.new(color.white, 30),
                                    width=1, style=line.style_dashed)
        array.push(_hrLines, _newHrLine)
        // Si excedimos el buffer, borrar la mas vieja
        if array.size(_hrLines) > _hrMaxLines
            line _oldHrLine = array.shift(_hrLines)
            line.delete(_oldHrLine)

float _pivSrcH = i_useBodyPivots ? math.max(open, close) : high
float _pivSrcL = i_useBodyPivots ? math.min(open, close) : low
float pivH_raw = ta.pivothigh(_pivSrcH, i_pivPer, i_pivPer)
float pivL_raw = ta.pivotlow(_pivSrcL,  i_pivPer, i_pivPer)

// Filtro de prominencia: el pivote debe sobresalir significativamente vs sus 20 vecinos.
// Un techo en consolidacion acumula poca prominencia y se descarta.
// Un techo de un rally fuerte acumula mucha prominencia y pasa.
float _promThresh = i_minPromATR * atrVal
float _promH = 0.0
if not na(pivH_raw)
    for k = 1 to i_pivPer
        _promH := _promH + (pivH_raw - _pivSrcH[i_pivPer + k])
        _promH := _promH + (pivH_raw - _pivSrcH[i_pivPer - k])
float _promL = 0.0
if not na(pivL_raw)
    for k = 1 to i_pivPer
        _promL := _promL + (_pivSrcL[i_pivPer + k] - pivL_raw)
        _promL := _promL + (_pivSrcL[i_pivPer - k] - pivL_raw)
float pivH = not na(pivH_raw) and _promH >= _promThresh ? pivH_raw : na
float pivL = not na(pivL_raw) and _promL >= _promThresh ? pivL_raw : na

// Debug visual: marcar pivotes que pasaron el filtro de prominencia (solo i_backtesting=true)
plot(i_backtesting and not na(pivH) ? pivH : na, title="Pivot High", style=plot.style_circles, color=color.aqua, linewidth=3, offset=-i_pivPer)
plot(i_backtesting and not na(pivL) ? pivL : na, title="Pivot Low",  style=plot.style_circles, color=color.fuchsia, linewidth=3, offset=-i_pivPer)

// Buffer de pivotes recientes. Tamano definido por input i_pivBuffer.
var int[]   _pH_b = array.new_int(i_pivBuffer,   int(na))
var float[] _pH_v = array.new_float(i_pivBuffer, float(na))
var int[]   _pL_b = array.new_int(i_pivBuffer,   int(na))
var float[] _pL_v = array.new_float(i_pivBuffer, float(na))

// Etiquetas de slot para debug visual: muestran el numero de slot que ocupa
// cada pivote en el buffer. Si un pivote no tiene etiqueta, esta fuera del array.
var label[] _pH_lbls = array.new<label>(i_pivBuffer, na)
var label[] _pL_lbls = array.new<label>(i_pivBuffer, na)

// Sistema de 3 slots por direccion (cascada de envejecimiento):
//   _cur = TL mas reciente -> label "1B" (mas solida)
//   _prv = TL anterior     -> label "2B" (medio fade)
//   _old = TL mas antigua  -> label "3B" (mas faded, proxima a morir)
// Cuando llega una nueva: old DELETE, prv->old, cur->prv, new->cur
var line  _tlH_cur = na,          var line  _tlH_prv = na,          var line  _tlH_old = na
var int   _scH_cur = 0,           var int   _scH_prv = 0,           var int   _scH_old = 0
var int   _b1H_cur = int(na),     var float _v1H_cur = float(na)
var int   _b2H_cur = int(na),     var float _v2H_cur = float(na)
var int   _b1H_prv = int(na),     var float _v1H_prv = float(na)
var int   _b2H_prv = int(na),     var float _v2H_prv = float(na)
var int   _b1H_old = int(na),     var float _v1H_old = float(na)
var int   _b2H_old = int(na),     var float _v2H_old = float(na)
var line  _tlL_cur = na,          var line  _tlL_prv = na,          var line  _tlL_old = na
var int   _scL_cur = 0,           var int   _scL_prv = 0,           var int   _scL_old = 0
var int   _b1L_cur = int(na),     var float _v1L_cur = float(na)
var int   _b2L_cur = int(na),     var float _v2L_cur = float(na)
var int   _b1L_prv = int(na),     var float _v1L_prv = float(na)
var int   _b2L_prv = int(na),     var float _v2L_prv = float(na)
var int   _b1L_old = int(na),     var float _v1L_old = float(na)
var int   _b2L_old = int(na),     var float _v2L_old = float(na)
var int   _tlH_score = 0
var int   _tlL_score = 0
// Etiquetas: 1B/1A = old (mas faded), 2B/2A = prv (medio), 3B/3A = cur (mas solida)
var label _lbl3B = na,   var label _lbl3A = na
var label _lbl2B = na,   var label _lbl2A = na
var label _lbl1B = na,   var label _lbl1A = na
var label _dbgH  = na,   var label _dbgL  = na
var label _dbgLine = na   // debug estado de lineas (1 sola, se actualiza cada barra)
var table _dbgTable = na  // debug tabla de estado de TODAS las lineas (esquina del chart)
var label _dbgBK = na
var label _lblH1B = na,  var label _lblH1A = na
var label _lblH4B = na,  var label _lblH4A = na
var label _lbl3BK = na,  var label _lbl2BK = na

// BK: TL rota usada como soporte/resistencia (role reversal)
var line  _tlBK_cur = na,      var line  _tlBK_prv = na
var int   _scBK_cur = 0,       var int   _scBK_prv = 0
var int   _b1BK_cur = int(na), var float _v1BK_cur = float(na)
var int   _b2BK_cur = int(na), var float _v2BK_cur = float(na)
var int   _b1BK_prv = int(na), var float _v1BK_prv = float(na)
var int   _b2BK_prv = int(na), var float _v2BK_prv = float(na)
var bool  _bkFromH_cur = false  // true = B rota -> LONG retest | false = A rota -> SHORT retest
var bool  _bkFromH_prv = false
var bool  _bkSlope_cur = false  // pendiente confirma tendencia en el momento del break
var bool  _bkSlope_prv = false
var int   _tlBK_score  = 0
// debounce: evita registrar el mismo break dos veces
var int   _bkH_src_b2  = int(na)
var int   _bkL_src_b2  = int(na)
// Ventana de vigilancia Judas - bar_index hasta el cual la BK actual sigue en evaluacion
var int   _bk_judas_until = int(na)
// Contador de aproximaciones del precio a la BK (despues de N, BK muere)
var int   _bkTouchCount   = 0
var bool  _bkInZonePrev   = false
// contadores de barras consecutivas con cierre mas alla de la TL
var int   _bkH_cnt_cur = 0
var int   _bkH_cnt_prv = 0
var int   _bkL_cnt_cur = 0
var int   _bkL_cnt_prv = 0
// tracking de cual slot H/L esta activo para senales
var bool  _tlH_from_prv = false
var bool  _tlL_from_prv = false

f_push(int[] bars, float[] vals, int b, float v) =>
    array.shift(bars)
    array.push(bars, b)
    array.shift(vals)
    array.push(vals, v)

// f_bestFit con mejoras expertas:
// - maxSlopeAbs: rechaza TLs con pendiente excesiva (Bulkowski - parabolicas insostenibles)
// - decayRate: pivotes recientes pesan mas (Linda Raschke - regimen actual)
// - useExtreme: fuerza al menos un anclaje en el pivote mas extremo (lectura visual)
// - isHigh: true para resistencias (highs), false para soportes (lows)
f_bestFit(int[] bars, float[] vals, float ftol, int nPiv, int minSpacing, bool isHigh, float maxSlopeAbs, float decayRate, bool useExtreme) =>
    int   N    = i_pivBuffer
    int   from = N - nPiv
    int   bestB1 = int(na),   bestB2 = int(na)
    float bestV1 = float(na), bestV2 = float(na)
    int   bestScore = -1
    float bestWeighted = -1.0    // score ponderado por recencia (criterio de seleccion)

    // Encontrar pivote extremo de la ventana si extreme anchor activo
    int   extremeIdx = -1
    float extremeVal = isHigh ? -1e10 : 1e10
    if useExtreme
        for kk = from to N - 1
            float vkk = array.get(vals, kk)
            int   bkk = array.get(bars, kk)
            if not na(vkk) and not na(bkk)
                if isHigh and vkk > extremeVal
                    extremeVal := vkk
                    extremeIdx := kk
                if not isHigh and vkk < extremeVal
                    extremeVal := vkk
                    extremeIdx := kk

    for i = from to N - 2
        int   bi = array.get(bars, i)
        float vi = array.get(vals, i)
        if na(bi)
            continue
        for j = i + 1 to N - 1
            int   bj = array.get(bars, j)
            float vj = array.get(vals, j)
            if na(bj) or bi == bj
                continue
            // Forzar anclaje en pivote extremo si activo
            if useExtreme and extremeIdx >= 0 and i != extremeIdx and j != extremeIdx
                continue
            float sl        = (vj - vi) / float(bj - bi)
            // Slope filter: rechazar TLs parabolicas
            if maxSlopeAbs > 0 and math.abs(sl) > maxSlopeAbs
                continue
            int   sc        = 0
            float weighted  = 0.0
            int   lastTouch = -9999
            for k = from to N - 1
                int   bk = array.get(bars, k)
                float vk = array.get(vals, k)
                if na(bk)
                    continue
                if math.abs(vk - (vi + sl * float(bk - bi))) <= ftol
                    if bk - lastTouch >= minSpacing
                        sc        += 1
                        // Anchors siempre peso 1.0; touches intermedios usan recency
                        bool isAnchor = (bk == bi) or (bk == bj)
                        float w = 1.0
                        if not isAnchor
                            float age = float(bar_index - bk)
                            w := decayRate < 1.0 ? math.pow(decayRate, age) : 1.0
                        weighted  += w
                        lastTouch := bk
            // Tiebreaker en empates: gana la linea con mayor span (mas estructural)
            int  spanCur = bj - bi
            int  spanBst = na(bestB1) or na(bestB2) ? 0 : bestB2 - bestB1
            bool longerSpan = spanCur > spanBst
            if weighted > bestWeighted or (weighted == bestWeighted and longerSpan)
                bestWeighted := weighted
                bestScore := sc
                bestB1 := bi
                bestV1 := vi
                bestB2 := bj
                bestV2 := vj
    [bestB1, bestV1, bestB2, bestV2, bestScore]

f_proj(int b1, float v1, int b2, float v2) =>
    (not na(b2) ?
        (not na(b1) and b2 > b1 ?
            v2 + (v2 - v1) / float(b2 - b1) * float(bar_index - b2) :
            v2) :
        float(na))

// Transparencia segun score: sc=1 -> 55%, sc=2 -> 30%, sc=3 -> 5%, sc=4+ -> 0% (solida)
f_tlAlpha(int sc) =>
    math.max(0, 80 - sc * 25)

// =============================================================================
// CONFLUENCIA HTF - trendlines de H1 y H4 proyectadas al bar actual
// =============================================================================

f_tlNow(float p1, int t1, float p2, int t2) =>
    (not na(p2) and not na(t2) ?
        (not na(p1) and not na(t1) and t2 > t1 ?
            p2 + (p2 - p1) / float(t2 - t1) * float(time - t2) :
            p2) :
        float(na))

f_htfH(int per) =>
    float piv = ta.pivothigh(high, per, per)
    bool  hit = not na(piv)
    float v2  = ta.valuewhen(hit, piv,       0)
    int   t2  = ta.valuewhen(hit, time[per], 0)
    float v1  = ta.valuewhen(hit, piv,       1)
    int   t1  = ta.valuewhen(hit, time[per], 1)
    [v2, t2, v1, t1]

f_htfL(int per) =>
    float piv = ta.pivotlow(low, per, per)
    bool  hit = not na(piv)
    float v2  = ta.valuewhen(hit, piv,       0)
    int   t2  = ta.valuewhen(hit, time[per], 0)
    float v1  = ta.valuewhen(hit, piv,       1)
    int   t1  = ta.valuewhen(hit, time[per], 1)
    [v2, t2, v1, t1]

[_h1rP2, _h1rT2, _h1rP1, _h1rT1] = request.security(syminfo.tickerid, i_htf1TF,
    f_htfH(i_htf1Period), lookahead=barmerge.lookahead_off)
[_h1sP2, _h1sT2, _h1sP1, _h1sT1] = request.security(syminfo.tickerid, i_htf1TF,
    f_htfL(i_htf1Period), lookahead=barmerge.lookahead_off)
[_h2rP2, _h2rT2, _h2rP1, _h2rT1] = request.security(syminfo.tickerid, i_htf2TF,
    f_htfH(i_htf2Period), lookahead=barmerge.lookahead_off)
[_h2sP2, _h2sT2, _h2sP1, _h2sT1] = request.security(syminfo.tickerid, i_htf2TF,
    f_htfL(i_htf2Period), lookahead=barmerge.lookahead_off)

float htf1H_now = f_tlNow(_h1rP1, _h1rT1, _h1rP2, _h1rT2)
float htf1L_now = f_tlNow(_h1sP1, _h1sT1, _h1sP2, _h1sT2)
float htf2H_now = f_tlNow(_h2rP1, _h2rT1, _h2rP2, _h2rT2)
float htf2L_now = f_tlNow(_h2sP1, _h2sT1, _h2sP2, _h2sT2)

var line  _htf1H_line = na
var line  _htf1L_line = na
var line  _htf2H_line = na
var line  _htf2L_line = na
var float _prev_h1rP2 = float(na)
var float _prev_h1sP2 = float(na)
var float _prev_h2rP2 = float(na)
var float _prev_h2sP2 = float(na)

// Detectar purge silencioso de Pine para HTF lines via line.get_x1 (na si purgada)
int  _htf1H_x1Safe = na(_htf1H_line) ? int(na) : line.get_x1(_htf1H_line)
bool _htf1H_purged = not na(_htf1H_line) and na(_htf1H_x1Safe)
int  _htf1L_x1Safe = na(_htf1L_line) ? int(na) : line.get_x1(_htf1L_line)
bool _htf1L_purged = not na(_htf1L_line) and na(_htf1L_x1Safe)
int  _htf2H_x1Safe = na(_htf2H_line) ? int(na) : line.get_x1(_htf2H_line)
bool _htf2H_purged = not na(_htf2H_line) and na(_htf2H_x1Safe)
int  _htf2L_x1Safe = na(_htf2L_line) ? int(na) : line.get_x1(_htf2L_line)
bool _htf2L_purged = not na(_htf2L_line) and na(_htf2L_x1Safe)

// Fix Pine quirk: na(_h1rP2) handle - en primera ejecucion _prev=na hace que != na devuelva na (no true)
// Recrear linea si: pivot cambio O linea fue purgada por max_lines_count
if not na(_h1rP2) and not na(_h1rP1) and (na(_prev_h1rP2) or _h1rP2 != _prev_h1rP2 or _htf1H_purged)
    line.delete(_htf1H_line)
    _htf1H_line := line.new(_h1rT1, _h1rP1, _h1rT2, _h1rP2,
                            xloc=xloc.bar_time, extend=extend.right,
                            color=i_colHTF1H, width=3, style=line.style_dashed)
    label.delete(_lblH1B)
    _lblH1B := label.new(bar_index + 3, _h1rP2, "H1B",
                         color=color.new(i_colHTF1H, 50), textcolor=color.white,
                         style=label.style_label_left, size=size.normal)
    _prev_h1rP2 := _h1rP2

if not na(_h1sP2) and not na(_h1sP1) and (na(_prev_h1sP2) or _h1sP2 != _prev_h1sP2 or _htf1L_purged)
    line.delete(_htf1L_line)
    _htf1L_line := line.new(_h1sT1, _h1sP1, _h1sT2, _h1sP2,
                            xloc=xloc.bar_time, extend=extend.right,
                            color=i_colHTF1L, width=3, style=line.style_dashed)
    label.delete(_lblH1A)
    _lblH1A := label.new(bar_index + 3, _h1sP2, "H1A",
                         color=color.new(i_colHTF1L, 50), textcolor=color.white,
                         style=label.style_label_left, size=size.normal)
    _prev_h1sP2 := _h1sP2

if not na(_h2rP2) and not na(_h2rP1) and (na(_prev_h2rP2) or _h2rP2 != _prev_h2rP2 or _htf2H_purged)
    line.delete(_htf2H_line)
    _htf2H_line := line.new(_h2rT1, _h2rP1, _h2rT2, _h2rP2,
                            xloc=xloc.bar_time, extend=extend.right,
                            color=i_colHTF2H, width=4, style=line.style_solid)
    label.delete(_lblH4B)
    _lblH4B := label.new(bar_index + 3, _h2rP2, "H4B",
                         color=color.new(i_colHTF2H, 50), textcolor=color.white,
                         style=label.style_label_left, size=size.normal)
    _prev_h2rP2 := _h2rP2

if not na(_h2sP2) and not na(_h2sP1) and (na(_prev_h2sP2) or _h2sP2 != _prev_h2sP2 or _htf2L_purged)
    line.delete(_htf2L_line)
    _htf2L_line := line.new(_h2sT1, _h2sP1, _h2sT2, _h2sP2,
                            xloc=xloc.bar_time, extend=extend.right,
                            color=i_colHTF2L, width=4, style=line.style_solid)
    label.delete(_lblH4A)
    _lblH4A := label.new(bar_index + 3, _h2sP2, "H4A",
                         color=color.new(i_colHTF2L, 50), textcolor=color.white,
                         style=label.style_label_left, size=size.normal)
    _prev_h2sP2 := _h2sP2

f_scoreBear(float lvl) =>
    float aTol     = atrVal * i_htfTol
    float roomDist = atrVal * i_htfRoomMinATR
    int   sc       = 0
    // Confluencia: HTF resistance cerca del nivel de entrada
    if not na(htf1H_now) and math.abs(lvl - htf1H_now) <= aTol
        sc += 1
    if not na(htf2H_now) and math.abs(lvl - htf2H_now) <= aTol
        sc += 2
    // Room to run (SHORT): HTF support lejos por debajo = espacio para caer
    if not na(htf1L_now) and (close - htf1L_now) >= roomDist
        sc += 1
    if not na(htf2L_now) and (close - htf2L_now) >= roomDist
        sc += 1
    if _inLD
        sc += 1
    if _inNY
        sc += 1
    // Bonus por TL fuerte: 4-6 toques = sweet spot. >=7 = penalizar (fatigue).
    if _tlH_score >= 4 and (not i_applyFatigue or _tlH_score <= 6)
        sc += 1
    if i_applyFatigue and _tlH_score >= 7
        sc -= 1
    sc

f_scoreBull(float lvl) =>
    float aTol     = atrVal * i_htfTol
    float roomDist = atrVal * i_htfRoomMinATR
    int   sc       = 0
    // Confluencia: HTF support cerca del nivel de entrada
    if not na(htf1L_now) and math.abs(lvl - htf1L_now) <= aTol
        sc += 1
    if not na(htf2L_now) and math.abs(lvl - htf2L_now) <= aTol
        sc += 2
    // Room to run (LONG): HTF resistance lejos por encima = espacio para subir
    if not na(htf1H_now) and (htf1H_now - close) >= roomDist
        sc += 1
    if not na(htf2H_now) and (htf2H_now - close) >= roomDist
        sc += 1
    if _inLD
        sc += 1
    if _inNY
        sc += 1
    // Bonus por TL fuerte: 4-6 toques = sweet spot. >=7 = penalizar (fatigue).
    if _tlL_score >= 4 and (not i_applyFatigue or _tlL_score <= 6)
        sc += 1
    if i_applyFatigue and _tlL_score >= 7
        sc -= 1
    sc

f_prob(int s) =>
    string txt = ""
    color  col = color.gray
    if s >= 5
        txt := "MUY ALTA"
        col := color.new(color.green, 0)
    else if s >= 4
        txt := "ALTA"
        col := color.new(#26A69A, 0)
    else if s >= 3
        txt := "MEDIA-ALTA"
        col := color.new(color.yellow, 0)
    else if s >= 2
        txt := "MEDIA"
        col := color.new(color.orange, 0)
    else
        txt := "BAJA"
        col := color.new(color.red, 20)
    [txt, col]

if not na(pivH)
    // Manejar label del pivote mas antiguo (que se va a sacar del buffer)
    label _oldH_lbl = array.get(_pH_lbls, 0)
    if not na(_oldH_lbl)
        label.delete(_oldH_lbl)
    f_push(_pH_b, _pH_v, bar_index - i_pivPer, pivH)
    array.shift(_pH_lbls)
    label _newH_lbl = i_backtesting ? label.new(bar_index - i_pivPer, pivH,
                                                 text=str.tostring(i_pivBuffer),
                                                 style=label.style_label_down,
                                                 color=color.new(color.aqua, 50),
                                                 textcolor=color.white,
                                                 size=size.tiny) : na
    array.push(_pH_lbls, _newH_lbl)
    // Actualizar texto de cada label para reflejar su nuevo slot
    if i_backtesting
        for _i = 0 to i_pivBuffer - 1
            label _lblH = array.get(_pH_lbls, _i)
            if not na(_lblH)
                label.set_text(_lblH, str.tostring(_i + 1))
    float _maxSlopeAbsH = i_maxSlopeATR > 0 ? i_maxSlopeATR * atrVal : 0.0
    float _decayH       = i_useRecencyBias ? i_recencyDecay : 1.0
    [b1, v1, b2, v2, sc] = f_bestFit(_pH_b, _pH_v, _tol, i_nPiv, i_minSpacing, true, _maxSlopeAbsH, _decayH, i_forceExtremeAnchor)
    if not na(b1)
        bool _newH = na(_b2H_cur) or b2 != _b2H_cur or b1 != _b1H_cur
        // Guard contra duplicacion de tendencia: si la nueva proyecta dentro
        // de N x ATR de la actual, es la misma tendencia y solo se actualiza in-place
        float _curHnowProj = f_proj(_b1H_cur, _v1H_cur, _b2H_cur, _v2H_cur)
        float _newHnowProj = f_proj(b1, v1, b2, v2)
        bool  _sameTendH = i_bkDupATR > 0 and not na(_curHnowProj) and not na(_newHnowProj) and math.abs(_newHnowProj - _curHnowProj) < i_bkDupATR * atrVal
        if _newH and not _sameTendH
            // CASCADA 3 slots: old DELETE, prv->old, cur->prv, new->cur
            // Step 1: borrar el mas antiguo (slot _old, label "3B")
            line.delete(_tlH_old)
            label.delete(_lbl3B)
            _lbl3B := na
            // Step 2: prv -> old (con su label "2B" -> "3B")
            _b1H_old := _b1H_prv,  _v1H_old := _v1H_prv
            _b2H_old := _b2H_prv,  _v2H_old := _v2H_prv
            _scH_old  := _scH_prv
            _tlH_old  := _tlH_prv
            _lbl3B    := _lbl2B
            _lbl2B    := na
            if not na(_tlH_old)
                line.set_color(_tlH_old, color.new(i_colH, 70))
                line.set_width(_tlH_old, 1)
                if not na(_lbl3B)
                    label.set_text(_lbl3B, "3B")
            // Step 3: cur -> prv (con su label "1B" -> "2B")
            _b1H_prv := _b1H_cur,  _v1H_prv := _v1H_cur
            _b2H_prv := _b2H_cur,  _v2H_prv := _v2H_cur
            _scH_prv  := _scH_cur
            _tlH_prv  := _tlH_cur
            _lbl2B    := _lbl1B
            _lbl1B    := na
            if not na(_tlH_prv)
                line.set_color(_tlH_prv, color.new(i_colH, 40))
                line.set_width(_tlH_prv, 1)
                if not na(_lbl2B)
                    label.set_text(_lbl2B, "2B")
            // Step 4: nueva TL -> cur (label "1B")
            _tlH_cur  := line.new(b1, v1, b2, v2,
                                  color=color.new(i_colH, f_tlAlpha(sc)),
                                  width=sc >= i_minTouches ? 2 : 1, extend=extend.right)
            _lbl1B := label.new(bar_index + 3, v2, "1B",
                                color=color.new(i_colH, 70), textcolor=i_colH,
                                style=label.style_label_left, size=size.small)
            _b1H_cur := b1,  _v1H_cur := v1
            _b2H_cur := b2,  _v2H_cur := v2
            _scH_cur  := sc
            _bkH_cnt_prv := _bkH_cnt_cur
        else if _newH and _sameTendH
            // Misma tendencia: actualizar cur in-place sin rotar
            line.set_xy1(_tlH_cur, b1, v1)
            line.set_xy2(_tlH_cur, b2, v2)
            line.set_color(_tlH_cur, color.new(i_colH, f_tlAlpha(sc)))
            line.set_width(_tlH_cur, sc >= i_minTouches ? 2 : 1)
            _b1H_cur := b1,  _v1H_cur := v1
            _b2H_cur := b2,  _v2H_cur := v2
            _scH_cur := sc
        else
            _scH_cur := sc
            // Safety: si la linea fue eliminada por evento previo, recrearla
            if na(_tlH_cur)
                _tlH_cur := line.new(b1, v1, b2, v2,
                                      color=color.new(i_colH, f_tlAlpha(sc)),
                                      width=sc >= i_minTouches ? 2 : 1, extend=extend.right)
                if na(_lbl1B)
                    _lbl1B := label.new(bar_index + 3, v2, "1B",
                                         color=color.new(i_colH, 70), textcolor=i_colH,
                                         style=label.style_label_left, size=size.small)
            else
                line.set_color(_tlH_cur, color.new(i_colH, f_tlAlpha(sc)))
                line.set_width(_tlH_cur, sc >= i_minTouches ? 2 : 1)
            if not na(_tlH_prv)
                int _aP = math.min(100, 40 + _scH_cur * 20)
                if _aP >= 98
                    line.delete(_tlH_prv)
                    _tlH_prv := na,      _scH_prv := 0
                    _b1H_prv := int(na), _v1H_prv := float(na)
                    _b2H_prv := int(na), _v2H_prv := float(na)
                    label.delete(_lbl2B)
                    _lbl2B := na
                else
                    line.set_color(_tlH_prv, color.new(i_colH, _aP))

if not na(pivL)
    label _oldL_lbl = array.get(_pL_lbls, 0)
    if not na(_oldL_lbl)
        label.delete(_oldL_lbl)
    f_push(_pL_b, _pL_v, bar_index - i_pivPer, pivL)
    array.shift(_pL_lbls)
    label _newL_lbl = i_backtesting ? label.new(bar_index - i_pivPer, pivL,
                                                 text=str.tostring(i_pivBuffer),
                                                 style=label.style_label_up,
                                                 color=color.new(color.fuchsia, 50),
                                                 textcolor=color.white,
                                                 size=size.tiny) : na
    array.push(_pL_lbls, _newL_lbl)
    if i_backtesting
        for _i = 0 to i_pivBuffer - 1
            label _lblL = array.get(_pL_lbls, _i)
            if not na(_lblL)
                label.set_text(_lblL, str.tostring(_i + 1))
    float _maxSlopeAbsL = i_maxSlopeATR > 0 ? i_maxSlopeATR * atrVal : 0.0
    float _decayL       = i_useRecencyBias ? i_recencyDecay : 1.0
    [b1, v1, b2, v2, sc] = f_bestFit(_pL_b, _pL_v, _tol, i_nPiv, i_minSpacing, false, _maxSlopeAbsL, _decayL, i_forceExtremeAnchor)
    if not na(b1)
        bool _newL = na(_b2L_cur) or b2 != _b2L_cur or b1 != _b1L_cur
        // Guard contra duplicacion de tendencia para A
        float _curLnowProj = f_proj(_b1L_cur, _v1L_cur, _b2L_cur, _v2L_cur)
        float _newLnowProj = f_proj(b1, v1, b2, v2)
        bool  _sameTendL = i_bkDupATR > 0 and not na(_curLnowProj) and not na(_newLnowProj) and math.abs(_newLnowProj - _curLnowProj) < i_bkDupATR * atrVal
        if _newL and not _sameTendL
            // CASCADA 3 slots: old DELETE, prv->old, cur->prv, new->cur
            line.delete(_tlL_old)
            label.delete(_lbl3A)
            _lbl3A := na
            _b1L_old := _b1L_prv,  _v1L_old := _v1L_prv
            _b2L_old := _b2L_prv,  _v2L_old := _v2L_prv
            _scL_old  := _scL_prv
            _tlL_old  := _tlL_prv
            _lbl3A    := _lbl2A
            _lbl2A    := na
            if not na(_tlL_old)
                line.set_color(_tlL_old, color.new(i_colL, 70))
                line.set_width(_tlL_old, 1)
                if not na(_lbl3A)
                    label.set_text(_lbl3A, "3A")
            _b1L_prv := _b1L_cur,  _v1L_prv := _v1L_cur
            _b2L_prv := _b2L_cur,  _v2L_prv := _v2L_cur
            _scL_prv  := _scL_cur
            _tlL_prv  := _tlL_cur
            _lbl2A    := _lbl1A
            _lbl1A    := na
            if not na(_tlL_prv)
                line.set_color(_tlL_prv, color.new(i_colL, 40))
                line.set_width(_tlL_prv, 1)
                if not na(_lbl2A)
                    label.set_text(_lbl2A, "2A")
            _tlL_cur  := line.new(b1, v1, b2, v2,
                                  color=color.new(i_colL, f_tlAlpha(sc)),
                                  width=sc >= i_minTouches ? 2 : 1, extend=extend.right)
            _lbl1A := label.new(bar_index + 3, v2, "1A",
                                color=color.new(i_colL, 70), textcolor=i_colL,
                                style=label.style_label_left, size=size.small)
            _b1L_cur := b1,  _v1L_cur := v1
            _b2L_cur := b2,  _v2L_cur := v2
            _scL_cur  := sc
            _bkL_cnt_prv := _bkL_cnt_cur
        else if _newL and _sameTendL
            // Misma tendencia: actualizar cur in-place sin demote a prv
            line.set_xy1(_tlL_cur, b1, v1)
            line.set_xy2(_tlL_cur, b2, v2)
            line.set_color(_tlL_cur, color.new(i_colL, f_tlAlpha(sc)))
            line.set_width(_tlL_cur, sc >= i_minTouches ? 2 : 1)
            _b1L_cur := b1,  _v1L_cur := v1
            _b2L_cur := b2,  _v2L_cur := v2
            _scL_cur := sc
        else
            _scL_cur := sc
            // Safety: si la linea fue eliminada por evento previo, recrearla
            if na(_tlL_cur)
                _tlL_cur := line.new(b1, v1, b2, v2,
                                      color=color.new(i_colL, f_tlAlpha(sc)),
                                      width=sc >= i_minTouches ? 2 : 1, extend=extend.right)
                if na(_lbl1A)
                    _lbl1A := label.new(bar_index + 3, v2, "1A",
                                         color=color.new(i_colL, 70), textcolor=i_colL,
                                         style=label.style_label_left, size=size.small)
            else
                line.set_color(_tlL_cur, color.new(i_colL, f_tlAlpha(sc)))
                line.set_width(_tlL_cur, sc >= i_minTouches ? 2 : 1)
            if not na(_tlL_prv)
                int _aP = math.min(100, 40 + _scL_cur * 20)
                if _aP >= 98
                    line.delete(_tlL_prv)
                    _tlL_prv := na,      _scL_prv := 0
                    _b1L_prv := int(na), _v1L_prv := float(na)
                    _b2L_prv := int(na), _v2L_prv := float(na)
                    label.delete(_lbl2A)
                    _lbl2A := na
                else
                    line.set_color(_tlL_prv, color.new(i_colL, _aP))

// Seleccionar la TL mas fuerte disponible (cur o prv) para senales de entrada
_tlH_score := 0
_tlL_score := 0
float _curH_now = f_proj(_b1H_cur, _v1H_cur, _b2H_cur, _v2H_cur)
float _prvH_now = f_proj(_b1H_prv, _v1H_prv, _b2H_prv, _v2H_prv)
float _curL_now = f_proj(_b1L_cur, _v1L_cur, _b2L_cur, _v2L_cur)
float _prvL_now = f_proj(_b1L_prv, _v1L_prv, _b2L_prv, _v2L_prv)

// Safety global: detectar purge silencioso de Pine via line.get_x1 (na si purgada)
int  _tlH_curX1Safe   = na(_tlH_cur) ? int(na) : line.get_x1(_tlH_cur)
bool _tlH_curPurged   = not na(_tlH_cur) and na(_tlH_curX1Safe)
int  _tlL_curX1Safe   = na(_tlL_cur) ? int(na) : line.get_x1(_tlL_cur)
bool _tlL_curPurged   = not na(_tlL_cur) and na(_tlL_curX1Safe)

if _scH_cur >= 1 and not na(_curH_now) and (na(_tlH_cur) or _tlH_curPurged) and not na(_b1H_cur) and not na(_b2H_cur)
    _tlH_cur := line.new(_b1H_cur, _v1H_cur, _b2H_cur, _v2H_cur,
                          color=color.new(i_colH, f_tlAlpha(_scH_cur)),
                          width=_scH_cur >= i_minTouches ? 2 : 1, extend=extend.right)
    if na(_lbl1B)
        _lbl1B := label.new(bar_index + 3, _v2H_cur, "1B",
                             color=color.new(i_colH, 70), textcolor=i_colH,
                             style=label.style_label_left, size=size.small)
if _scL_cur >= 1 and not na(_curL_now) and (na(_tlL_cur) or _tlL_curPurged) and not na(_b1L_cur) and not na(_b2L_cur)
    _tlL_cur := line.new(_b1L_cur, _v1L_cur, _b2L_cur, _v2L_cur,
                          color=color.new(i_colL, f_tlAlpha(_scL_cur)),
                          width=_scL_cur >= i_minTouches ? 2 : 1, extend=extend.right)
    if na(_lbl1A)
        _lbl1A := label.new(bar_index + 3, _v2L_cur, "1A",
                             color=color.new(i_colL, 70), textcolor=i_colL,
                             style=label.style_label_left, size=size.small)

// Safety BK: detectar purge real con line.get_x1 (retorna na si la linea fue eliminada).
// Si state vars son validas pero linea fue purgada, recrear SOLO entonces (sin flood).
int  _bkX1Test    = na(_tlBK_cur) ? int(na) : line.get_x1(_tlBK_cur)
bool _bkLinePurged = not na(_tlBK_cur) and na(_bkX1Test)
if _scBK_cur >= 1 and not na(_b1BK_cur) and not na(_b2BK_cur) and (na(_tlBK_cur) or _bkLinePurged)
    _tlBK_cur := line.new(_b1BK_cur, _v1BK_cur, _b2BK_cur, _v2BK_cur,
                          color=color.new(i_colBK, f_tlAlpha(_scBK_cur)),
                          width=2, style=line.style_dashed, extend=extend.right)
    if na(_lbl3BK)
        _lbl3BK := label.new(bar_index + 3, _v2BK_cur, "1BK",
                             color=color.new(i_colBK, 70), textcolor=i_colBK,
                             style=label.style_label_left, size=size.small)

// Cleanup AGRESIVO: si dos slots tienen MISMA DIRECCION (slope similar) o COMPARTEN
// NIVEL (proyeccion cercana), son redundantes. Solo se preservan slots que representan
// DIRECCIONES O NIVELES distintos. Esto es lo que da valor a tener 3 slots: cada uno
// representa una tendencia genuinamente diferente del historico.
// Pares evaluados: 1B vs 2B, 1B vs 3B, 2B vs 3B (la mas antigua se elimina).
float _curSlopeH_cln = not na(_b1H_cur) and not na(_b2H_cur) and _b2H_cur > _b1H_cur ? (_v2H_cur - _v1H_cur) / float(_b2H_cur - _b1H_cur) : float(na)
float _prvSlopeH_cln = not na(_b1H_prv) and not na(_b2H_prv) and _b2H_prv > _b1H_prv ? (_v2H_prv - _v1H_prv) / float(_b2H_prv - _b1H_prv) : float(na)
float _oldSlopeH_cln = not na(_b1H_old) and not na(_b2H_old) and _b2H_old > _b1H_old ? (_v2H_old - _v1H_old) / float(_b2H_old - _b1H_old) : float(na)
// (Removidas _curHprojCln/_prvHprojCln/_oldHprojCln: cleanup ya no usa nivel)
// CLEANUP RELAJADO: solo borra si las dos lineas tienen MISMA PENDIENTE.
// Si comparten nivel pero diferente pendiente = lineas distintas, mantener ambas.
// Esto preserva mas lineas vivas para que mejora #1 (3-slot picker) tenga opciones.
float _slopeTolH   = atrVal * 0.02  // mas estricto que antes (0.05) = elimina menos

// 1B vs 2B: solo borra si MISMA PENDIENTE (no por nivel)
if not na(_tlH_prv) and not na(_curSlopeH_cln) and not na(_prvSlopeH_cln)
    bool _sameSlopeH12 = math.abs(_curSlopeH_cln - _prvSlopeH_cln) < _slopeTolH
    if _sameSlopeH12
        line.delete(_tlH_prv)
        label.delete(_lbl2B)
        _tlH_prv := na
        _b1H_prv := int(na),  _v1H_prv := float(na)
        _b2H_prv := int(na),  _v2H_prv := float(na)
        _scH_prv  := 0
        _bkH_cnt_prv := 0
        _lbl2B := na

// 1B vs 3B: solo borra si MISMA PENDIENTE
if not na(_tlH_old) and not na(_curSlopeH_cln) and not na(_oldSlopeH_cln)
    bool _sameSlopeH13 = math.abs(_curSlopeH_cln - _oldSlopeH_cln) < _slopeTolH
    if _sameSlopeH13
        line.delete(_tlH_old)
        label.delete(_lbl3B)
        _tlH_old := na
        _b1H_old := int(na),  _v1H_old := float(na)
        _b2H_old := int(na),  _v2H_old := float(na)
        _scH_old  := 0
        _lbl3B := na

// 2B vs 3B: solo borra si MISMA PENDIENTE
if not na(_tlH_prv) and not na(_tlH_old) and not na(_prvSlopeH_cln) and not na(_oldSlopeH_cln)
    bool _sameSlopeH23 = math.abs(_prvSlopeH_cln - _oldSlopeH_cln) < _slopeTolH
    if _sameSlopeH23
        line.delete(_tlH_old)
        label.delete(_lbl3B)
        _tlH_old := na
        _b1H_old := int(na),  _v1H_old := float(na)
        _b2H_old := int(na),  _v2H_old := float(na)
        _scH_old  := 0
        _lbl3B := na

// Mismo bloque para A (lows)
float _curSlopeL_cln = not na(_b1L_cur) and not na(_b2L_cur) and _b2L_cur > _b1L_cur ? (_v2L_cur - _v1L_cur) / float(_b2L_cur - _b1L_cur) : float(na)
float _prvSlopeL_cln = not na(_b1L_prv) and not na(_b2L_prv) and _b2L_prv > _b1L_prv ? (_v2L_prv - _v1L_prv) / float(_b2L_prv - _b1L_prv) : float(na)
float _oldSlopeL_cln = not na(_b1L_old) and not na(_b2L_old) and _b2L_old > _b1L_old ? (_v2L_old - _v1L_old) / float(_b2L_old - _b1L_old) : float(na)
// (Removidas _curLprojCln/_prvLprojCln/_oldLprojCln: cleanup ya no usa nivel)

if not na(_tlL_prv) and not na(_curSlopeL_cln) and not na(_prvSlopeL_cln)
    bool _sameSlopeL12 = math.abs(_curSlopeL_cln - _prvSlopeL_cln) < _slopeTolH
    if _sameSlopeL12
        line.delete(_tlL_prv)
        label.delete(_lbl2A)
        _tlL_prv := na
        _b1L_prv := int(na),  _v1L_prv := float(na)
        _b2L_prv := int(na),  _v2L_prv := float(na)
        _scL_prv  := 0
        _bkL_cnt_prv := 0
        _lbl2A := na

if not na(_tlL_old) and not na(_curSlopeL_cln) and not na(_oldSlopeL_cln)
    bool _sameSlopeL13 = math.abs(_curSlopeL_cln - _oldSlopeL_cln) < _slopeTolH
    if _sameSlopeL13
        line.delete(_tlL_old)
        label.delete(_lbl3A)
        _tlL_old := na
        _b1L_old := int(na),  _v1L_old := float(na)
        _b2L_old := int(na),  _v2L_old := float(na)
        _scL_old  := 0
        _lbl3A := na

if not na(_tlL_prv) and not na(_tlL_old) and not na(_prvSlopeL_cln) and not na(_oldSlopeL_cln)
    bool _sameSlopeL23 = math.abs(_prvSlopeL_cln - _oldSlopeL_cln) < _slopeTolH
    if _sameSlopeL23
        line.delete(_tlL_old)
        label.delete(_lbl3A)
        _tlL_old := na
        _b1L_old := int(na),  _v1L_old := float(na)
        _b2L_old := int(na),  _v2L_old := float(na)
        _scL_old  := 0
        _lbl3A := na

// Per-bar position updates para los 3 slots (3=cur, 2=prv, 1=old)
float _oldH_now = f_proj(_b1H_old, _v1H_old, _b2H_old, _v2H_old)
float _oldL_now = f_proj(_b1L_old, _v1L_old, _b2L_old, _v2L_old)
if not na(_lbl1B) and not na(_curH_now)
    label.set_x(_lbl1B, bar_index + 3)
    label.set_y(_lbl1B, _curH_now)
if not na(_lbl2B) and not na(_prvH_now)
    label.set_x(_lbl2B, bar_index + 3)
    label.set_y(_lbl2B, _prvH_now)
if not na(_lbl3B) and not na(_oldH_now)
    label.set_x(_lbl3B, bar_index + 3)
    label.set_y(_lbl3B, _oldH_now)
if not na(_lbl1A) and not na(_curL_now)
    label.set_x(_lbl1A, bar_index + 3)
    label.set_y(_lbl1A, _curL_now)
if not na(_lbl2A) and not na(_prvL_now)
    label.set_x(_lbl2A, bar_index + 3)
    label.set_y(_lbl2A, _prvL_now)
if not na(_lbl3A) and not na(_oldL_now)
    label.set_x(_lbl3A, bar_index + 3)
    label.set_y(_lbl3A, _oldL_now)
if not na(_lblH1B) and not na(htf1H_now)
    label.set_x(_lblH1B, bar_index + 3)
    label.set_y(_lblH1B, htf1H_now)
if not na(_lblH1A) and not na(htf1L_now)
    label.set_x(_lblH1A, bar_index + 3)
    label.set_y(_lblH1A, htf1L_now)
if not na(_lblH4B) and not na(htf2H_now)
    label.set_x(_lblH4B, bar_index + 3)
    label.set_y(_lblH4B, htf2H_now)
if not na(_lblH4A) and not na(htf2L_now)
    label.set_x(_lblH4A, bar_index + 3)
    label.set_y(_lblH4A, htf2L_now)
float _bkCurNow = f_proj(_b1BK_cur, _v1BK_cur, _b2BK_cur, _v2BK_cur)
float _bkPrvNow = f_proj(_b1BK_prv, _v1BK_prv, _b2BK_prv, _v2BK_prv)
if not na(_lbl3BK) and not na(_bkCurNow)
    label.set_x(_lbl3BK, bar_index + 3)
    label.set_y(_lbl3BK, _bkCurNow)
if not na(_lbl2BK) and not na(_bkPrvNow)
    label.set_x(_lbl2BK, bar_index + 3)
    label.set_y(_lbl2BK, _bkPrvNow)

float tlH_now = float(na)
float tlL_now = float(na)

_tlH_from_prv := false
_tlL_from_prv := false

if _scH_cur >= i_minTouches and not na(_curH_now)
    if not na(_prvH_now) and _scH_prv > _scH_cur
        tlH_now := _prvH_now
        _tlH_score := _scH_prv
        _tlH_from_prv := true
    else
        tlH_now := _curH_now
        _tlH_score := _scH_cur
else if _scH_prv >= i_minTouches and not na(_prvH_now)
    tlH_now := _prvH_now
    _tlH_score := _scH_prv
    _tlH_from_prv := true

if _scL_cur >= i_minTouches and not na(_curL_now)
    if not na(_prvL_now) and _scL_prv > _scL_cur
        tlL_now := _prvL_now
        _tlL_score := _scL_prv
        _tlL_from_prv := true
    else
        tlL_now := _curL_now
        _tlL_score := _scL_cur
else if _scL_prv >= i_minTouches and not na(_prvL_now)
    tlL_now := _prvL_now
    _tlL_score := _scL_prv
    _tlL_from_prv := true

// =============================================================================
// BREAK DETECTION - TL rota se convierte en linea BK (role reversal)
// Break valido: cierre mas alla de la TL por i_bkMinATR*ATR durante i_bkConfirmBars barras consecutivas
// Judas swing: break de 1-2 velas ignorado (contador no alcanza el umbral)
// =============================================================================
float _bkMinDist = i_bkMinATR * atrVal

// Filtro de volumen: bar de break debe tener volumen sobre el promedio
float _volAvg  = ta.sma(volume, 20)
bool  _volOK   = not i_useVolFilter or (not na(_volAvg) and volume >= _volAvg * i_volMult)

// Filtro de body completo: si activado, open tambien debe estar al lado correcto
// (Edwards & Magee: solo body breaks son confiables, no wicks)
bool _bodyAboveH_cur = not i_useBodyBreak or (not na(_curH_now) and math.min(open, close) > _curH_now)
bool _bodyAboveH_prv = not i_useBodyBreak or (not na(_prvH_now) and math.min(open, close) > _prvH_now)
bool _bodyBelowL_cur = not i_useBodyBreak or (not na(_curL_now) and math.max(open, close) < _curL_now)
bool _bodyBelowL_prv = not i_useBodyBreak or (not na(_prvL_now) and math.max(open, close) < _prvL_now)

// Actualizar contadores de barras consecutivas mas alla de cada slot
if not na(_curH_now) and close > _curH_now + _bkMinDist and _volOK and _bodyAboveH_cur
    _bkH_cnt_cur += 1
else
    _bkH_cnt_cur := 0
if not na(_prvH_now) and close > _prvH_now + _bkMinDist and _volOK and _bodyAboveH_prv
    _bkH_cnt_prv += 1
else
    _bkH_cnt_prv := 0
if not na(_curL_now) and close < _curL_now - _bkMinDist and _volOK and _bodyBelowL_cur
    _bkL_cnt_cur += 1
else
    _bkL_cnt_cur := 0
if not na(_prvL_now) and close < _prvL_now - _bkMinDist and _volOK and _bodyBelowL_prv
    _bkL_cnt_prv += 1
else
    _bkL_cnt_prv := 0

// =============================================================================
// DEBUG TABLE: estado de TODAS las lineas en una tabla esquina del chart
// =============================================================================
if i_backtesting
    if na(_dbgTable)
        _dbgTable := table.new(position.bottom_right, 5, 12,
                               bgcolor=color.new(color.black, 20),
                               border_width=1, border_color=color.new(color.gray, 50))
        // Headers
        table.cell(_dbgTable, 0, 0, "LINE",   text_color=color.yellow, bgcolor=color.new(color.gray, 70), text_size=size.small)
        table.cell(_dbgTable, 1, 0, "Ref",    text_color=color.yellow, bgcolor=color.new(color.gray, 70), text_size=size.small)
        table.cell(_dbgTable, 2, 0, "x1",     text_color=color.yellow, bgcolor=color.new(color.gray, 70), text_size=size.small)
        table.cell(_dbgTable, 3, 0, "Alive",  text_color=color.yellow, bgcolor=color.new(color.gray, 70), text_size=size.small)
        table.cell(_dbgTable, 4, 0, "Score",  text_color=color.yellow, bgcolor=color.new(color.gray, 70), text_size=size.small)

    // Helper inline para checkear cada linea
    int _dbT_tlH_x1   = na(_tlH_cur)    ? int(na) : line.get_x1(_tlH_cur)
    int _dbT_tlHp_x1  = na(_tlH_prv)    ? int(na) : line.get_x1(_tlH_prv)
    int _dbT_tlHo_x1  = na(_tlH_old)    ? int(na) : line.get_x1(_tlH_old)
    int _dbT_tlL_x1   = na(_tlL_cur)    ? int(na) : line.get_x1(_tlL_cur)
    int _dbT_tlLp_x1  = na(_tlL_prv)    ? int(na) : line.get_x1(_tlL_prv)
    int _dbT_tlLo_x1  = na(_tlL_old)    ? int(na) : line.get_x1(_tlL_old)
    int _dbT_bk_x1    = na(_tlBK_cur)   ? int(na) : line.get_x1(_tlBK_cur)
    int _dbT_h1H_x1   = na(_htf1H_line) ? int(na) : line.get_x1(_htf1H_line)
    int _dbT_h1L_x1   = na(_htf1L_line) ? int(na) : line.get_x1(_htf1L_line)
    int _dbT_h2H_x1   = na(_htf2H_line) ? int(na) : line.get_x1(_htf2H_line)
    int _dbT_h2L_x1   = na(_htf2L_line) ? int(na) : line.get_x1(_htf2L_line)

    // Helper para "alive" status
    f_aliveStatus(line ln, int x1) =>
        bool _alive = not na(ln) and not na(x1)
        [_alive ? "YES" : "NO", _alive ? color.lime : color.red]
    [_a1, _c1]   = f_aliveStatus(_tlH_cur,    _dbT_tlH_x1)
    [_a2, _c2]   = f_aliveStatus(_tlH_prv,    _dbT_tlHp_x1)
    [_a3, _c3]   = f_aliveStatus(_tlH_old,    _dbT_tlHo_x1)
    [_a4, _c4]   = f_aliveStatus(_tlL_cur,    _dbT_tlL_x1)
    [_a5, _c5]   = f_aliveStatus(_tlL_prv,    _dbT_tlLp_x1)
    [_a6, _c6]   = f_aliveStatus(_tlL_old,    _dbT_tlLo_x1)
    [_a7, _c7]   = f_aliveStatus(_tlBK_cur,   _dbT_bk_x1)
    [_a8, _c8]   = f_aliveStatus(_htf1H_line, _dbT_h1H_x1)
    [_a9, _c9]   = f_aliveStatus(_htf1L_line, _dbT_h1L_x1)
    [_a10, _c10] = f_aliveStatus(_htf2H_line, _dbT_h2H_x1)
    [_a11, _c11] = f_aliveStatus(_htf2L_line, _dbT_h2L_x1)

    // Llenar filas
    table.cell(_dbgTable, 0, 1, "1B (H cur)", text_color=color.white, text_size=size.small)
    table.cell(_dbgTable, 1, 1, na(_tlH_cur) ? "NA" : "ok", text_color=color.white, text_size=size.small)
    table.cell(_dbgTable, 2, 1, na(_dbT_tlH_x1) ? "-" : str.tostring(_dbT_tlH_x1), text_color=color.white, text_size=size.small)
    table.cell(_dbgTable, 3, 1, _a1, text_color=_c1, text_size=size.small)
    table.cell(_dbgTable, 4, 1, str.tostring(_scH_cur), text_color=color.white, text_size=size.small)

    table.cell(_dbgTable, 0, 2, "2B (H prv)", text_color=color.white, text_size=size.small)
    table.cell(_dbgTable, 1, 2, na(_tlH_prv) ? "NA" : "ok", text_color=color.white, text_size=size.small)
    table.cell(_dbgTable, 2, 2, na(_dbT_tlHp_x1) ? "-" : str.tostring(_dbT_tlHp_x1), text_color=color.white, text_size=size.small)
    table.cell(_dbgTable, 3, 2, _a2, text_color=_c2, text_size=size.small)
    table.cell(_dbgTable, 4, 2, str.tostring(_scH_prv), text_color=color.white, text_size=size.small)

    table.cell(_dbgTable, 0, 3, "3B (H old)", text_color=color.white, text_size=size.small)
    table.cell(_dbgTable, 1, 3, na(_tlH_old) ? "NA" : "ok", text_color=color.white, text_size=size.small)
    table.cell(_dbgTable, 2, 3, na(_dbT_tlHo_x1) ? "-" : str.tostring(_dbT_tlHo_x1), text_color=color.white, text_size=size.small)
    table.cell(_dbgTable, 3, 3, _a3, text_color=_c3, text_size=size.small)
    table.cell(_dbgTable, 4, 3, str.tostring(_scH_old), text_color=color.white, text_size=size.small)

    table.cell(_dbgTable, 0, 4, "1A (L cur)", text_color=color.white, text_size=size.small)
    table.cell(_dbgTable, 1, 4, na(_tlL_cur) ? "NA" : "ok", text_color=color.white, text_size=size.small)
    table.cell(_dbgTable, 2, 4, na(_dbT_tlL_x1) ? "-" : str.tostring(_dbT_tlL_x1), text_color=color.white, text_size=size.small)
    table.cell(_dbgTable, 3, 4, _a4, text_color=_c4, text_size=size.small)
    table.cell(_dbgTable, 4, 4, str.tostring(_scL_cur), text_color=color.white, text_size=size.small)

    table.cell(_dbgTable, 0, 5, "2A (L prv)", text_color=color.white, text_size=size.small)
    table.cell(_dbgTable, 1, 5, na(_tlL_prv) ? "NA" : "ok", text_color=color.white, text_size=size.small)
    table.cell(_dbgTable, 2, 5, na(_dbT_tlLp_x1) ? "-" : str.tostring(_dbT_tlLp_x1), text_color=color.white, text_size=size.small)
    table.cell(_dbgTable, 3, 5, _a5, text_color=_c5, text_size=size.small)
    table.cell(_dbgTable, 4, 5, str.tostring(_scL_prv), text_color=color.white, text_size=size.small)

    table.cell(_dbgTable, 0, 6, "3A (L old)", text_color=color.white, text_size=size.small)
    table.cell(_dbgTable, 1, 6, na(_tlL_old) ? "NA" : "ok", text_color=color.white, text_size=size.small)
    table.cell(_dbgTable, 2, 6, na(_dbT_tlLo_x1) ? "-" : str.tostring(_dbT_tlLo_x1), text_color=color.white, text_size=size.small)
    table.cell(_dbgTable, 3, 6, _a6, text_color=_c6, text_size=size.small)
    table.cell(_dbgTable, 4, 6, str.tostring(_scL_old), text_color=color.white, text_size=size.small)

    table.cell(_dbgTable, 0, 7, "BK", text_color=color.white, text_size=size.small)
    table.cell(_dbgTable, 1, 7, na(_tlBK_cur) ? "NA" : "ok", text_color=color.white, text_size=size.small)
    table.cell(_dbgTable, 2, 7, na(_dbT_bk_x1) ? "-" : str.tostring(_dbT_bk_x1), text_color=color.white, text_size=size.small)
    table.cell(_dbgTable, 3, 7, _a7, text_color=_c7, text_size=size.small)
    table.cell(_dbgTable, 4, 7, str.tostring(_scBK_cur), text_color=color.white, text_size=size.small)

    table.cell(_dbgTable, 0, 8, "HTF1B", text_color=color.white, text_size=size.small)
    table.cell(_dbgTable, 1, 8, na(_htf1H_line) ? "NA" : "ok", text_color=color.white, text_size=size.small)
    table.cell(_dbgTable, 2, 8, na(_dbT_h1H_x1) ? "-" : str.tostring(_dbT_h1H_x1), text_color=color.white, text_size=size.small)
    table.cell(_dbgTable, 3, 8, _a8, text_color=_c8, text_size=size.small)
    table.cell(_dbgTable, 4, 8, "-", text_color=color.white, text_size=size.small)

    table.cell(_dbgTable, 0, 9, "HTF1A", text_color=color.white, text_size=size.small)
    table.cell(_dbgTable, 1, 9, na(_htf1L_line) ? "NA" : "ok", text_color=color.white, text_size=size.small)
    table.cell(_dbgTable, 2, 9, na(_dbT_h1L_x1) ? "-" : str.tostring(_dbT_h1L_x1), text_color=color.white, text_size=size.small)
    table.cell(_dbgTable, 3, 9, _a9, text_color=_c9, text_size=size.small)
    table.cell(_dbgTable, 4, 9, "-", text_color=color.white, text_size=size.small)

    table.cell(_dbgTable, 0, 10, "HTF4B", text_color=color.white, text_size=size.small)
    table.cell(_dbgTable, 1, 10, na(_htf2H_line) ? "NA" : "ok", text_color=color.white, text_size=size.small)
    table.cell(_dbgTable, 2, 10, na(_dbT_h2H_x1) ? "-" : str.tostring(_dbT_h2H_x1), text_color=color.white, text_size=size.small)
    table.cell(_dbgTable, 3, 10, _a10, text_color=_c10, text_size=size.small)
    table.cell(_dbgTable, 4, 10, "-", text_color=color.white, text_size=size.small)

    table.cell(_dbgTable, 0, 11, "HTF4A", text_color=color.white, text_size=size.small)
    table.cell(_dbgTable, 1, 11, na(_htf2L_line) ? "NA" : "ok", text_color=color.white, text_size=size.small)
    table.cell(_dbgTable, 2, 11, na(_dbT_h2L_x1) ? "-" : str.tostring(_dbT_h2L_x1), text_color=color.white, text_size=size.small)
    table.cell(_dbgTable, 3, 11, _a11, text_color=_c11, text_size=size.small)
    table.cell(_dbgTable, 4, 11, "-", text_color=color.white, text_size=size.small)

// Debug labels (solo cuando i_backtesting activo) - muestran estado de contadores BK
if i_backtesting
    string _dH = "H cntCur=" + str.tostring(_bkH_cnt_cur) +
                 " cntPrv=" + str.tostring(_bkH_cnt_prv) +
                 "\nscCur=" + str.tostring(_scH_cur) +
                 " scPrv=" + str.tostring(_scH_prv) +
                 "\nclsCur=" + (not na(_curH_now) ? str.tostring(close - _curH_now, format.mintick) : "na") +
                 " clsPrv=" + (not na(_prvH_now) ? str.tostring(close - _prvH_now, format.mintick) : "na") +
                 "\ndist=" + str.tostring(_bkMinDist, format.mintick) +
                 "\nb2c=" + str.tostring(_b2H_cur) +
                 " b2p=" + str.tostring(_b2H_prv) +
                 " src=" + str.tostring(_bkH_src_b2) +
                 "\n--- HTF ---" +
                 "\nH1B=" + (not na(htf1H_now) ? str.tostring(htf1H_now, format.mintick) : "na") +
                 " (d=" + (not na(htf1H_now) ? str.tostring(htf1H_now - close, format.mintick) : "na") + ")" +
                 "\nH4B=" + (not na(htf2H_now) ? str.tostring(htf2H_now, format.mintick) : "na") +
                 " (d=" + (not na(htf2H_now) ? str.tostring(htf2H_now - close, format.mintick) : "na") + ")"
    if na(_dbgH)
        _dbgH := label.new(bar_index, high + atrVal * 3, _dH,
                           style=label.style_label_down, color=color.new(color.blue, 70),
                           textcolor=color.white, size=size.normal)
    else
        label.set_x(_dbgH, bar_index)
        label.set_y(_dbgH, high + atrVal * 3)
        label.set_text(_dbgH, _dH)
    string _dL = "L cntCur=" + str.tostring(_bkL_cnt_cur) +
                 " cntPrv=" + str.tostring(_bkL_cnt_prv) +
                 "\nscCur=" + str.tostring(_scL_cur) +
                 " scPrv=" + str.tostring(_scL_prv) +
                 "\nclsCur=" + (not na(_curL_now) ? str.tostring(close - _curL_now, format.mintick) : "na") +
                 " clsPrv=" + (not na(_prvL_now) ? str.tostring(close - _prvL_now, format.mintick) : "na") +
                 "\ndist=" + str.tostring(_bkMinDist, format.mintick) +
                 "\nb2c=" + str.tostring(_b2L_cur) +
                 " b2p=" + str.tostring(_b2L_prv) +
                 " src=" + str.tostring(_bkL_src_b2) +
                 "\n--- HTF ---" +
                 "\nH1A=" + (not na(htf1L_now) ? str.tostring(htf1L_now, format.mintick) : "na") +
                 " (d=" + (not na(htf1L_now) ? str.tostring(close - htf1L_now, format.mintick) : "na") + ")" +
                 "\nH4A=" + (not na(htf2L_now) ? str.tostring(htf2L_now, format.mintick) : "na") +
                 " (d=" + (not na(htf2L_now) ? str.tostring(close - htf2L_now, format.mintick) : "na") + ")"
    if na(_dbgL)
        _dbgL := label.new(bar_index, low - atrVal * 3, _dL,
                           style=label.style_label_up, color=color.new(color.purple, 70),
                           textcolor=color.white, size=size.normal)
    else
        label.set_x(_dbgL, bar_index)
        label.set_y(_dbgL, low - atrVal * 3)
        label.set_text(_dbgL, _dL)

// Bloque de rotacion BK inlineado (restriccion v6: no puede modificar vars globales en funcion)
// Break confirmado cuando el contador supera i_bkConfirmBars (>= para no depender del frame exacto)
// Guard de duplicados: si la BK candidata proyecta cerca de la BK actual, es la misma tendencia
float _candProj1B = f_proj(_b1H_cur, _v1H_cur, _b2H_cur, _v2H_cur)
float _candProj2B = f_proj(_b1H_prv, _v1H_prv, _b2H_prv, _v2H_prv)
float _candProj1A = f_proj(_b1L_cur, _v1L_cur, _b2L_cur, _v2L_cur)
float _candProj2A = f_proj(_b1L_prv, _v1L_prv, _b2L_prv, _v2L_prv)
float _curBKProj  = f_proj(_b1BK_cur, _v1BK_cur, _b2BK_cur, _v2BK_cur)
float _bkDupDist  = i_bkDupATR * atrVal
bool  _dup1B = i_bkDupATR > 0 and not na(_curBKProj) and not na(_candProj1B) and math.abs(_candProj1B - _curBKProj) < _bkDupDist
bool  _dup2B = i_bkDupATR > 0 and not na(_curBKProj) and not na(_candProj2B) and math.abs(_candProj2B - _curBKProj) < _bkDupDist
bool  _dup1A = i_bkDupATR > 0 and not na(_curBKProj) and not na(_candProj1A) and math.abs(_candProj1A - _curBKProj) < _bkDupDist
bool  _dup2A = i_bkDupATR > 0 and not na(_curBKProj) and not na(_candProj2A) and math.abs(_candProj2A - _curBKProj) < _bkDupDist

// Break de 1B (cur slot) - slot unico, BK vieja se elimina
if _bkH_cnt_cur >= i_bkConfirmBars and (na(_bkH_src_b2) or _b2H_cur != _bkH_src_b2) and _scH_cur >= i_bkMinTouches and not _dup1B
    _bkH_src_b2 := _b2H_cur
    line.delete(_tlBK_cur)
    label.delete(_lbl3BK)
    _b1BK_cur := _b1H_cur,  _v1BK_cur := _v1H_cur
    _b2BK_cur := _b2H_cur,  _v2BK_cur := _v2H_cur
    _scBK_cur := _scH_cur,  _bkFromH_cur := true,  _bkSlope_cur := _v2H_cur < _v1H_cur
    _tlBK_cur := line.new(_b1H_cur, _v1H_cur, _b2H_cur, _v2H_cur,
                          color=color.new(i_colBK, f_tlAlpha(_scH_cur)),
                          width=2, style=line.style_dashed, extend=extend.right)
    _lbl3BK := label.new(bar_index + 3, _v2H_cur, "1BK",
                         color=color.new(i_colBK, 70), textcolor=i_colBK,
                         style=label.style_label_left, size=size.small)
    // Label estatico en barra de confirmacion del break (1B rota al alza)
    label.new(bar_index, high + atrVal * 0.3, "BK 1B",
              style=label.style_label_down,
              color=color.new(i_colBK, 30), textcolor=color.white, size=size.tiny)
    _bk_judas_until := bar_index + i_bkJudasBars
    _bkTouchCount   := 0
    _bkInZonePrev   := false
    line.delete(_tlH_cur)
    label.delete(_lbl1B)
    _tlH_cur := na
    _lbl1B   := na
    _scH_cur := 0
    _bkH_cnt_cur := 0

// Break de 2B (prv slot) cuando 1B sigue intacta - slot unico, BK vieja se elimina
else if _bkH_cnt_prv >= i_bkConfirmBars and (na(_bkH_src_b2) or _b2H_prv != _bkH_src_b2) and _scH_prv >= i_bkMinTouches and not _dup2B
    _bkH_src_b2 := _b2H_prv
    line.delete(_tlBK_cur)
    label.delete(_lbl3BK)
    _b1BK_cur := _b1H_prv,  _v1BK_cur := _v1H_prv
    _b2BK_cur := _b2H_prv,  _v2BK_cur := _v2H_prv
    _scBK_cur := _scH_prv,  _bkFromH_cur := true,  _bkSlope_cur := _v2H_prv < _v1H_prv
    _tlBK_cur := line.new(_b1H_prv, _v1H_prv, _b2H_prv, _v2H_prv,
                          color=color.new(i_colBK, f_tlAlpha(_scH_prv)),
                          width=2, style=line.style_dashed, extend=extend.right)
    _lbl3BK := label.new(bar_index + 3, _v2H_prv, "1BK",
                         color=color.new(i_colBK, 70), textcolor=i_colBK,
                         style=label.style_label_left, size=size.small)
    // Label estatico en barra de confirmacion del break (2B rota al alza)
    label.new(bar_index, high + atrVal * 0.3, "BK 2B",
              style=label.style_label_down,
              color=color.new(i_colBK, 30), textcolor=color.white, size=size.tiny)
    _bk_judas_until := bar_index + i_bkJudasBars
    _bkTouchCount   := 0
    _bkInZonePrev   := false
    line.delete(_tlH_prv)
    label.delete(_lbl2B)
    _tlH_prv := na
    _lbl2B   := na
    _scH_prv := 0
    _bkH_cnt_prv := 0

// Break de 1A (cur slot) - slot unico, BK vieja se elimina
if _bkL_cnt_cur >= i_bkConfirmBars and (na(_bkL_src_b2) or _b2L_cur != _bkL_src_b2) and _scL_cur >= i_bkMinTouches and not _dup1A
    _bkL_src_b2 := _b2L_cur
    line.delete(_tlBK_cur)
    label.delete(_lbl3BK)
    _b1BK_cur := _b1L_cur,  _v1BK_cur := _v1L_cur
    _b2BK_cur := _b2L_cur,  _v2BK_cur := _v2L_cur
    _scBK_cur := _scL_cur,  _bkFromH_cur := false,  _bkSlope_cur := _v2L_cur > _v1L_cur
    _tlBK_cur := line.new(_b1L_cur, _v1L_cur, _b2L_cur, _v2L_cur,
                          color=color.new(i_colBK, f_tlAlpha(_scL_cur)),
                          width=2, style=line.style_dashed, extend=extend.right)
    _lbl3BK := label.new(bar_index + 3, _v2L_cur, "1BK",
                         color=color.new(i_colBK, 70), textcolor=i_colBK,
                         style=label.style_label_left, size=size.small)
    // Label estatico en barra de confirmacion del break (1A rota a la baja)
    label.new(bar_index, low - atrVal * 0.3, "BK 1A",
              style=label.style_label_up,
              color=color.new(i_colBK, 30), textcolor=color.white, size=size.tiny)
    _bk_judas_until := bar_index + i_bkJudasBars
    _bkTouchCount   := 0
    _bkInZonePrev   := false
    line.delete(_tlL_cur)
    label.delete(_lbl1A)
    _tlL_cur := na
    _lbl1A   := na
    _scL_cur := 0
    _bkL_cnt_cur := 0

// Break de 2A (prv slot) cuando 1A sigue intacta - slot unico, BK vieja se elimina
else if _bkL_cnt_prv >= i_bkConfirmBars and (na(_bkL_src_b2) or _b2L_prv != _bkL_src_b2) and _scL_prv >= i_bkMinTouches and not _dup2A
    _bkL_src_b2 := _b2L_prv
    line.delete(_tlBK_cur)
    label.delete(_lbl3BK)
    _b1BK_cur := _b1L_prv,  _v1BK_cur := _v1L_prv
    _b2BK_cur := _b2L_prv,  _v2BK_cur := _v2L_prv
    _scBK_cur := _scL_prv,  _bkFromH_cur := false,  _bkSlope_cur := _v2L_prv > _v1L_prv
    _tlBK_cur := line.new(_b1L_prv, _v1L_prv, _b2L_prv, _v2L_prv,
                          color=color.new(i_colBK, f_tlAlpha(_scL_prv)),
                          width=2, style=line.style_dashed, extend=extend.right)
    _lbl3BK := label.new(bar_index + 3, _v2L_prv, "1BK",
                         color=color.new(i_colBK, 70), textcolor=i_colBK,
                         style=label.style_label_left, size=size.small)
    // Label estatico en barra de confirmacion del break (2A rota a la baja)
    label.new(bar_index, low - atrVal * 0.3, "BK 2A",
              style=label.style_label_up,
              color=color.new(i_colBK, 30), textcolor=color.white, size=size.tiny)
    _bk_judas_until := bar_index + i_bkJudasBars
    _bkTouchCount   := 0
    _bkInZonePrev   := false
    line.delete(_tlL_prv)
    label.delete(_lbl2A)
    _tlL_prv := na
    _lbl2A   := na
    _scL_prv := 0
    _bkL_cnt_prv := 0

// =============================================================================
// JUDAS FILTER - invalida BK si dentro de la ventana de vigilancia el precio
// cierra de regreso al lado original de la TL rota. Restaura la TL al slot
// original (fiel a la realidad: si fue Judas, ese nivel sigue siendo valido).
// =============================================================================
if not na(_bk_judas_until) and bar_index <= _bk_judas_until and not na(_tlBK_cur)
    float _bkProj_now = f_proj(_b1BK_cur, _v1BK_cur, _b2BK_cur, _v2BK_cur)
    float _judasDist  = i_bkJudasATR * atrVal
    bool  _judasNow   = false
    if _bkFromH_cur and not na(_bkProj_now) and close < _bkProj_now - _judasDist
        _judasNow := true
    if not _bkFromH_cur and not na(_bkProj_now) and close > _bkProj_now + _judasDist
        _judasNow := true
    if _judasNow
        // Borrar BK (linea + label flotante 1BK)
        line.delete(_tlBK_cur)
        label.delete(_lbl3BK)
        _tlBK_cur := na
        _lbl3BK   := na
        // Restaurar TL original SIEMPRE en slot 1 (es mas fuerte por su historia).
        // Si cur ya tenia una TL nueva, esta se demote a slot 2 (tenue).
        if _bkFromH_cur
            if na(_tlH_cur)
                // Cur libre: restaurar directo
                _b1H_cur := _b1BK_cur,  _v1H_cur := _v1BK_cur
                _b2H_cur := _b2BK_cur,  _v2H_cur := _v2BK_cur
                _scH_cur := _scBK_cur
                _bkH_cnt_cur := 0
                _tlH_cur := line.new(_b1H_cur, _v1H_cur, _b2H_cur, _v2H_cur,
                                      color=color.new(i_colH, f_tlAlpha(_scH_cur)),
                                      width=_scH_cur >= i_minTouches ? 2 : 1, extend=extend.right)
                _lbl1B := label.new(bar_index + 3, _v2H_cur, "1B",
                                     color=color.new(i_colH, 70), textcolor=i_colH,
                                     style=label.style_label_left, size=size.small)
            else
                // Cur ocupada: SWAP. TL nueva se demote a 2B, TL restaurada va a 1B.
                line.delete(_tlH_prv)
                label.delete(_lbl2B)
                _b1H_prv := _b1H_cur,  _v1H_prv := _v1H_cur
                _b2H_prv := _b2H_cur,  _v2H_prv := _v2H_cur
                _scH_prv := _scH_cur
                _bkH_cnt_prv := _bkH_cnt_cur
                _tlH_prv := _tlH_cur
                if not na(_tlH_prv)
                    line.set_color(_tlH_prv, color.new(i_colH, 40))
                    line.set_width(_tlH_prv, 1)
                label.delete(_lbl1B)
                _lbl2B := label.new(bar_index + 3, _v2H_prv, "2B",
                                     color=color.new(i_colH, 85), textcolor=i_colH,
                                     style=label.style_label_left, size=size.small)
                _b1H_cur := _b1BK_cur,  _v1H_cur := _v1BK_cur
                _b2H_cur := _b2BK_cur,  _v2H_cur := _v2BK_cur
                _scH_cur := _scBK_cur
                _bkH_cnt_cur := 0
                _tlH_cur := line.new(_b1H_cur, _v1H_cur, _b2H_cur, _v2H_cur,
                                      color=color.new(i_colH, f_tlAlpha(_scH_cur)),
                                      width=_scH_cur >= i_minTouches ? 2 : 1, extend=extend.right)
                _lbl1B := label.new(bar_index + 3, _v2H_cur, "1B",
                                     color=color.new(i_colH, 70), textcolor=i_colH,
                                     style=label.style_label_left, size=size.small)
            _bkH_src_b2 := int(na)
            // Label JUDAS abajo (precio retorno por debajo de BK)
            label.new(bar_index, low - atrVal * 0.3, "JUDAS",
                      style=label.style_label_up,
                      color=color.new(color.yellow, 20), textcolor=color.black, size=size.small)
        else
            if na(_tlL_cur)
                _b1L_cur := _b1BK_cur,  _v1L_cur := _v1BK_cur
                _b2L_cur := _b2BK_cur,  _v2L_cur := _v2BK_cur
                _scL_cur := _scBK_cur
                _bkL_cnt_cur := 0
                _tlL_cur := line.new(_b1L_cur, _v1L_cur, _b2L_cur, _v2L_cur,
                                      color=color.new(i_colL, f_tlAlpha(_scL_cur)),
                                      width=_scL_cur >= i_minTouches ? 2 : 1, extend=extend.right)
                _lbl1A := label.new(bar_index + 3, _v2L_cur, "1A",
                                     color=color.new(i_colL, 70), textcolor=i_colL,
                                     style=label.style_label_left, size=size.small)
            else
                line.delete(_tlL_prv)
                label.delete(_lbl2A)
                _b1L_prv := _b1L_cur,  _v1L_prv := _v1L_cur
                _b2L_prv := _b2L_cur,  _v2L_prv := _v2L_cur
                _scL_prv := _scL_cur
                _bkL_cnt_prv := _bkL_cnt_cur
                _tlL_prv := _tlL_cur
                if not na(_tlL_prv)
                    line.set_color(_tlL_prv, color.new(i_colL, 40))
                    line.set_width(_tlL_prv, 1)
                label.delete(_lbl1A)
                _lbl2A := label.new(bar_index + 3, _v2L_prv, "2A",
                                     color=color.new(i_colL, 85), textcolor=i_colL,
                                     style=label.style_label_left, size=size.small)
                _b1L_cur := _b1BK_cur,  _v1L_cur := _v1BK_cur
                _b2L_cur := _b2BK_cur,  _v2L_cur := _v2BK_cur
                _scL_cur := _scBK_cur
                _bkL_cnt_cur := 0
                _tlL_cur := line.new(_b1L_cur, _v1L_cur, _b2L_cur, _v2L_cur,
                                      color=color.new(i_colL, f_tlAlpha(_scL_cur)),
                                      width=_scL_cur >= i_minTouches ? 2 : 1, extend=extend.right)
                _lbl1A := label.new(bar_index + 3, _v2L_cur, "1A",
                                     color=color.new(i_colL, 70), textcolor=i_colL,
                                     style=label.style_label_left, size=size.small)
            _bkL_src_b2 := int(na)
            // Label JUDAS arriba (precio retorno por encima de BK)
            label.new(bar_index, high + atrVal * 0.3, "JUDAS",
                      style=label.style_label_down,
                      color=color.new(color.yellow, 20), textcolor=color.black, size=size.small)
        // Limpiar estado BK
        _b1BK_cur := int(na),    _v1BK_cur := float(na)
        _b2BK_cur := int(na),    _v2BK_cur := float(na)
        _scBK_cur := 0
        _bk_judas_until := int(na)
        _bkTouchCount   := 0
        _bkInZonePrev   := false

// =============================================================================
// CICLO DE VIDA DE BK: tras N aproximaciones, GRADUA a TL normal (1B/1A)
// Razon: la BK pierde su fuerza explosiva tras multiples retests, pero el nivel
// sigue siendo respetado por el mercado, asi que se reincorpora como TL regular
// que puede generar senales bullSig/bearSig (sin fuerza extra de BK).
// =============================================================================
if not na(_tlBK_cur)
    float _bkProjLife = f_proj(_b1BK_cur, _v1BK_cur, _b2BK_cur, _v2BK_cur)
    float _bkTouchTol = atrVal * 0.5
    bool  _inZoneNow  = false
    if not na(_bkProjLife)
        if _bkFromH_cur
            // BK desde H break (resistencia rota -> ahora soporte): aproximacion = low cerca
            _inZoneNow := low <= _bkProjLife + _bkTouchTol and low >= _bkProjLife - _bkTouchTol
        else
            // BK desde L break (soporte roto -> ahora resistencia): aproximacion = high cerca
            _inZoneNow := high <= _bkProjLife + _bkTouchTol and high >= _bkProjLife - _bkTouchTol
    // Contar solo NUEVAS aproximaciones (transicion de fuera a dentro de la zona)
    if _inZoneNow and not _bkInZonePrev
        _bkTouchCount += 1
    _bkInZonePrev := _inZoneNow
    // Tras N aproximaciones, GRADUAR BK a TL normal con SWAP de slots
    if _bkTouchCount >= i_bkMaxTouches
        // Eliminar BK
        line.delete(_tlBK_cur)
        label.delete(_lbl3BK)
        _tlBK_cur := na
        _lbl3BK   := na
        // Restaurar BK SIEMPRE en slot 1 (es mas fuerte por su historia: TL->BK->retests).
        // Si cur ya tenia una TL nueva, esta se demote a slot 2 (tenue).
        if _bkFromH_cur
            if na(_tlH_cur)
                _b1H_cur := _b1BK_cur,  _v1H_cur := _v1BK_cur
                _b2H_cur := _b2BK_cur,  _v2H_cur := _v2BK_cur
                _scH_cur := _scBK_cur
                _bkH_cnt_cur := 0
                _tlH_cur := line.new(_b1H_cur, _v1H_cur, _b2H_cur, _v2H_cur,
                                      color=color.new(i_colH, f_tlAlpha(_scH_cur)),
                                      width=_scH_cur >= i_minTouches ? 2 : 1, extend=extend.right)
                _lbl1B := label.new(bar_index + 3, _v2H_cur, "1B",
                                     color=color.new(i_colH, 70), textcolor=i_colH,
                                     style=label.style_label_left, size=size.small)
            else
                // SWAP: TL nueva (cur) se demote a 2B (tenue), TL graduada va a 1B
                line.delete(_tlH_prv)
                label.delete(_lbl2B)
                _b1H_prv := _b1H_cur,  _v1H_prv := _v1H_cur
                _b2H_prv := _b2H_cur,  _v2H_prv := _v2H_cur
                _scH_prv := _scH_cur
                _bkH_cnt_prv := _bkH_cnt_cur
                _tlH_prv := _tlH_cur
                if not na(_tlH_prv)
                    line.set_color(_tlH_prv, color.new(i_colH, 40))
                    line.set_width(_tlH_prv, 1)
                label.delete(_lbl1B)
                _lbl2B := label.new(bar_index + 3, _v2H_prv, "2B",
                                     color=color.new(i_colH, 85), textcolor=i_colH,
                                     style=label.style_label_left, size=size.small)
                _b1H_cur := _b1BK_cur,  _v1H_cur := _v1BK_cur
                _b2H_cur := _b2BK_cur,  _v2H_cur := _v2BK_cur
                _scH_cur := _scBK_cur
                _bkH_cnt_cur := 0
                _tlH_cur := line.new(_b1H_cur, _v1H_cur, _b2H_cur, _v2H_cur,
                                      color=color.new(i_colH, f_tlAlpha(_scH_cur)),
                                      width=_scH_cur >= i_minTouches ? 2 : 1, extend=extend.right)
                _lbl1B := label.new(bar_index + 3, _v2H_cur, "1B",
                                     color=color.new(i_colH, 70), textcolor=i_colH,
                                     style=label.style_label_left, size=size.small)
            _bkH_src_b2 := int(na)
        else
            if na(_tlL_cur)
                _b1L_cur := _b1BK_cur,  _v1L_cur := _v1BK_cur
                _b2L_cur := _b2BK_cur,  _v2L_cur := _v2BK_cur
                _scL_cur := _scBK_cur
                _bkL_cnt_cur := 0
                _tlL_cur := line.new(_b1L_cur, _v1L_cur, _b2L_cur, _v2L_cur,
                                      color=color.new(i_colL, f_tlAlpha(_scL_cur)),
                                      width=_scL_cur >= i_minTouches ? 2 : 1, extend=extend.right)
                _lbl1A := label.new(bar_index + 3, _v2L_cur, "1A",
                                     color=color.new(i_colL, 70), textcolor=i_colL,
                                     style=label.style_label_left, size=size.small)
            else
                // SWAP: TL nueva (cur) se demote a 2A (tenue), TL graduada va a 1A
                line.delete(_tlL_prv)
                label.delete(_lbl2A)
                _b1L_prv := _b1L_cur,  _v1L_prv := _v1L_cur
                _b2L_prv := _b2L_cur,  _v2L_prv := _v2L_cur
                _scL_prv := _scL_cur
                _bkL_cnt_prv := _bkL_cnt_cur
                _tlL_prv := _tlL_cur
                if not na(_tlL_prv)
                    line.set_color(_tlL_prv, color.new(i_colL, 40))
                    line.set_width(_tlL_prv, 1)
                label.delete(_lbl1A)
                _lbl2A := label.new(bar_index + 3, _v2L_prv, "2A",
                                     color=color.new(i_colL, 85), textcolor=i_colL,
                                     style=label.style_label_left, size=size.small)
                _b1L_cur := _b1BK_cur,  _v1L_cur := _v1BK_cur
                _b2L_cur := _b2BK_cur,  _v2L_cur := _v2BK_cur
                _scL_cur := _scBK_cur
                _bkL_cnt_cur := 0
                _tlL_cur := line.new(_b1L_cur, _v1L_cur, _b2L_cur, _v2L_cur,
                                      color=color.new(i_colL, f_tlAlpha(_scL_cur)),
                                      width=_scL_cur >= i_minTouches ? 2 : 1, extend=extend.right)
                _lbl1A := label.new(bar_index + 3, _v2L_cur, "1A",
                                     color=color.new(i_colL, 70), textcolor=i_colL,
                                     style=label.style_label_left, size=size.small)
            _bkL_src_b2 := int(na)
        // Limpiar estado BK
        _b1BK_cur := int(na),  _v1BK_cur := float(na)
        _b2BK_cur := int(na),  _v2BK_cur := float(na)
        _scBK_cur := 0
        _bk_judas_until := int(na)
        // Label de graduacion
        if not na(_bkProjLife)
            label.new(bar_index, _bkProjLife, "BK->TL",
                      style=label.style_label_left,
                      color=color.new(color.gray, 30), textcolor=color.white, size=size.tiny)
        _bkTouchCount := 0
        _bkInZonePrev := false

// =============================================================================
// SENALES: wick de rechazo contra la trendline proyectada al bar actual
// La trendline debe tener al menos i_minTouches pivotes confirmados.
// Entrada inmediata en el close del bar de rechazo.
// =============================================================================
float _range  = high - low
float _upWick = high - math.max(open, close)
float _dnWick = math.min(open, close) - low

// Disparo en la barra del toque, sin requisito de close[1].
// Antes: close[1] > lvl + tol*0.3 exigia que la barra anterior cerro arriba/abajo,
//        lo cual rechazaba el primer toque despues de un BK donde el precio venia roto.
// Ahora: close de barra actual cerca/arriba (long) o cerca/abajo (short) de la linea
//        + wick de rechazo. La entrada dispara en el rechazo mismo.
f_bearRej(float lvl) =>
    (not na(lvl) and _range > 0
    and high >= lvl - _tol
    and high <= lvl + _tol * 1.5
    and close < lvl + _tol * 0.3
    and _upWick / _range >= i_wickRatio)

f_bullRej(float lvl) =>
    (not na(lvl) and _range > 0
    and low <= lvl + _tol
    and low >= lvl - _tol * 1.5
    and close > lvl - _tol * 0.3
    and _dnWick / _range >= i_wickRatio)

// _tradeOpen se lee al inicio del bar (antes de cualquier cierre).
// Garantiza que en el bar donde SL/TP es tocado NO se abre un nuevo trade.
var bool  _tradeOpen = false

// Helpers para TP estructural: encuentran el siguiente nivel en la direccion del trade
// y validan que la R/R disponible justifique el target (sino, fallback a 1:2).
// maxDist: cap absoluto de distancia desde entry. Niveles mas lejos son ignorados.
f_structTPLong(float entry, float slDist, float tlH, float htf1H, float htf2H, float buffer, float minRR, float maxDist) =>
    float bestTarget = float(na)
    // Local TL: solo si esta arriba y dentro del cap de distancia
    if not na(tlH) and tlH > entry and (tlH - entry) <= maxDist
        bestTarget := tlH
    // HTF1: mismo filtro, gana si esta mas cerca que el actual
    if not na(htf1H) and htf1H > entry and (htf1H - entry) <= maxDist and (na(bestTarget) or htf1H < bestTarget)
        bestTarget := htf1H
    // HTF2: mismo filtro
    if not na(htf2H) and htf2H > entry and (htf2H - entry) <= maxDist and (na(bestTarget) or htf2H < bestTarget)
        bestTarget := htf2H
    float adjusted = na(bestTarget) ? float(na) : bestTarget - buffer
    float minTP = entry + slDist * minRR
    not na(adjusted) and adjusted > minTP ? adjusted : float(na)

f_structTPShort(float entry, float slDist, float tlL, float htf1L, float htf2L, float buffer, float minRR, float maxDist) =>
    float bestTarget = float(na)
    if not na(tlL) and tlL < entry and (entry - tlL) <= maxDist
        bestTarget := tlL
    if not na(htf1L) and htf1L < entry and (entry - htf1L) <= maxDist and (na(bestTarget) or htf1L > bestTarget)
        bestTarget := htf1L
    if not na(htf2L) and htf2L < entry and (entry - htf2L) <= maxDist and (na(bestTarget) or htf2L > bestTarget)
        bestTarget := htf2L
    float adjusted = na(bestTarget) ? float(na) : bestTarget + buffer
    float minTP = entry - slDist * minRR
    not na(adjusted) and adjusted < minTP ? adjusted : float(na)

int _bearScore = f_scoreBear(tlH_now)
int _bullScore = f_scoreBull(tlL_now)

bool bearSig = (f_bearRej(tlH_now)
    and _tlH_score >= i_minTouches
    and _bearScore >= i_minScore
    and not _tradeOpen
    and _sesOK and _inTradeHours)

bool bullSig = (f_bullRej(tlL_now)
    and _tlL_score >= i_minTouches
    and _bullScore >= i_minScore
    and not _tradeOpen
    and _sesOK and _inTradeHours)

// Senales BK: retest de TL rota (role reversal)
// Filtro de consolidacion: pendiente primero (opcion 2), spread ATR como fallback (opcion 1)
float _baSpread = not na(tlH_now) and not na(tlL_now) ? math.abs(tlH_now - tlL_now) : float(na)
_tlBK_score := not na(_bkCurNow) ? _scBK_cur : (not na(_bkPrvNow) ? _scBK_prv : 0)
float tlBK_now = not na(_bkCurNow) ? _bkCurNow : (not na(_bkPrvNow) ? _bkPrvNow : float(na))
bool  _bkIsH   = not na(_bkCurNow) ? _bkFromH_cur : _bkFromH_prv
bool  _bkSlope = not na(_bkCurNow) ? _bkSlope_cur  : _bkSlope_prv
bool  _bkFilter = _bkSlope or (not na(_baSpread) and _baSpread > i_minSpreadATR * atrVal)

bool bkBullSig = (not na(tlBK_now) and _bkIsH
    and f_bullRej(tlBK_now)
    and _bkFilter
    and not _tradeOpen
    and _sesOK and _inTradeHours)

bool bkBearSig = (not na(tlBK_now) and not _bkIsH
    and f_bearRej(tlBK_now)
    and _bkFilter
    and not _tradeOpen
    and _sesOK and _inTradeHours)

// Debug BK signal: muestra que condicion esta bloqueando un retest cercano
if i_backtesting and not na(tlBK_now)
    float _diff   = math.abs(close - tlBK_now)
    bool  _near   = _diff < atrVal * 1.5
    if _near
        bool _c_bullRej = _bkIsH and f_bullRej(tlBK_now)
        bool _c_bearRej = not _bkIsH and f_bearRej(tlBK_now)
        bool _c_filter  = _bkFilter
        bool _c_notOpen = not _tradeOpen
        bool _c_ses     = _sesOK
        bool _c_hours   = _inTradeHours
        float _wickRatio = _range > 0 ? (_bkIsH ? _dnWick : _upWick) / _range : 0
        string _dBK = "BK " + (_bkIsH ? "(H->LONG)" : "(L->SHORT)") +
                     "\nlvl=" + str.tostring(tlBK_now, format.mintick) +
                     " close=" + str.tostring(close, format.mintick) +
                     "\nrej=" + str.tostring(_bkIsH ? _c_bullRej : _c_bearRej) +
                     " filter=" + str.tostring(_c_filter) +
                     "\nnotOpen=" + str.tostring(_c_notOpen) +
                     " ses=" + str.tostring(_c_ses) +
                     " hr=" + str.tostring(_c_hours) +
                     "\nwick%=" + str.tostring(_wickRatio * 100, "#.#") +
                     " (need " + str.tostring(i_wickRatio * 100, "#.#") + ")" +
                     "\ncls[1]=" + str.tostring(close[1], format.mintick) +
                     "\nlow=" + str.tostring(low, format.mintick) +
                     " high=" + str.tostring(high, format.mintick)
        if na(_dbgBK)
            _dbgBK := label.new(bar_index, tlBK_now + atrVal * 2, _dBK,
                               style=label.style_label_left, color=color.new(color.orange, 70),
                               textcolor=color.white, size=size.normal)
        else
            label.set_x(_dbgBK, bar_index)
            label.set_y(_dbgBK, tlBK_now + atrVal * 2)
            label.set_text(_dbgBK, _dBK)

plotshape(bearSig,   "SHORT entrada",    location=location.abovebar,
          color=i_colH,  style=shape.triangledown, size=size.small)
plotshape(bullSig,   "LONG entrada",     location=location.belowbar,
          color=i_colL,  style=shape.triangleup,   size=size.small)
plotshape(bkBearSig, "SHORT-BK entrada", location=location.abovebar,
          color=i_colBK, style=shape.triangledown, size=size.tiny)
plotshape(bkBullSig, "LONG-BK entrada",  location=location.belowbar,
          color=i_colBK, style=shape.triangleup,   size=size.tiny)

// =============================================================================
// ENTRADAS + CAJAS R/R (siempre visibles, patron acc-scalping)
// =============================================================================
var bool  trActive = false
var box   trRisk   = na
var box   trProfit = na
var int   nClosed  = 0
var float trSL     = float(na)
var float trTP     = float(na)
var bool  trLong   = false
var float trEntry  = float(na)   // precio de entrada (para calcular $ profit del TP)
var int   trEntryBar = int(na)   // barra de entrada (para posicionar TP labels en el medio)
// Tracking de elementos visuales del trade actual (para limpiar al cierre)
var line  _trSlLine  = na
var line  _trTp2Line = na
var line  _trTp3Line = na
var label _trTp2Lbl  = na
var label _trTp3Lbl  = na
var label _trProbLbl = na

if trActive
    bool _hitSL  = trLong ? low  <= trSL : high >= trSL
    bool _hitTP  = trLong ? high >= trTP : low  <= trTP
    // Cierre forzado al fin de zona operativa: ningun trade sobrevive el dia
    bool _hrEnded = not _inTradeHours and _inTradeHours[1]
    if _hitSL or _hitTP or _hrEnded or strategy.closedtrades > nClosed
        // Extender cajas al bar de cierre para que sea visible donde se ejecuto
        box.set_right(trRisk,   bar_index)
        box.set_right(trProfit, bar_index)
        // Calcular barra del medio del box (entry -> close) para reposicionar labels
        int _midBar = na(trEntryBar) ? bar_index : math.round((trEntryBar + bar_index) / 2)
        // Label con $ segun como cerro + limpieza de elementos visuales
        if _hitTP and not na(trEntry) and not na(trTP) and not na(trSL)
            // TP cumplido: mover TP label al medio del box, eliminar TP3 y SL (no materializaron)
            float _slDistAbs = math.abs(trEntry - trSL)
            float _tpDistAbs = math.abs(trTP - trEntry)
            float _rrActual  = _slDistAbs > 0 ? _tpDistAbs / _slDistAbs : 0
            float _profitUSD = i_riskUSD * _rrActual
            label.new(bar_index, trTP,
                      "+$" + str.tostring(math.round(_profitUSD)) +
                      "  (1:" + str.tostring(_rrActual, "#.##") + ")",
                      style=trLong ? label.style_label_down : label.style_label_up,
                      color=color.new(#9B59B6, 15), textcolor=color.white, size=size.small)
            // Mover TP2 label al medio del box (visible solo en winners)
            if not na(_trTp2Lbl)
                label.set_x(_trTp2Lbl, _midBar)
            if not na(_trTp2Line)
                line.set_x2(_trTp2Line, bar_index)
            // Eliminar TP3 (no materializo)
            line.delete(_trTp3Line)
            label.delete(_trTp3Lbl)
            _trTp3Line := na
            _trTp3Lbl  := na
            // Eliminar SL line/label (no materializo)
            line.delete(_trSlLine)
            _trSlLine := na
        else if _hitSL
            // SL cumplido: eliminar TP labels y lines (no materializaron)
            label.new(bar_index, trSL,
                      "-$" + str.tostring(math.round(i_riskUSD)),
                      style=trLong ? label.style_label_up : label.style_label_down,
                      color=color.new(color.white, 15), textcolor=color.black, size=size.small)
            line.delete(_trTp2Line)
            label.delete(_trTp2Lbl)
            line.delete(_trTp3Line)
            label.delete(_trTp3Lbl)
            _trTp2Line := na
            _trTp2Lbl  := na
            _trTp3Line := na
            _trTp3Lbl  := na
        else if _hrEnded and not na(trEntry) and not na(trSL)
            // Cierre EOD: forzar cerrar la posicion a precio de mercado y mostrar PnL real
            // Eliminar TP labels (no se cumplieron)
            float _slDistEod = math.abs(trEntry - trSL)
            float _qtyEod    = _slDistEod > 0 ? i_riskUSD / _slDistEod : 0
            float _pnlEod    = (trLong ? (close - trEntry) : (trEntry - close)) * _qtyEod
            strategy.close_all(comment="EOD")
            label.new(bar_index, close,
                      "EOD: " + (_pnlEod >= 0 ? "+$" : "-$") + str.tostring(math.abs(math.round(_pnlEod))),
                      style=label.style_label_left,
                      color=color.new(color.orange, 25), textcolor=color.white, size=size.small)
            line.delete(_trTp2Line)
            label.delete(_trTp2Lbl)
            line.delete(_trTp3Line)
            label.delete(_trTp3Lbl)
            line.delete(_trSlLine)
            _trTp2Line := na
            _trTp2Lbl  := na
            _trTp3Line := na
            _trTp3Lbl  := na
            _trSlLine  := na
        else
            // Fallback: strategy.closedtrades > nClosed sin razon especifica detectada
            // Limpiar todos los elementos visuales para evitar labels huerfanos
            line.delete(_trTp2Line)
            label.delete(_trTp2Lbl)
            line.delete(_trTp3Line)
            label.delete(_trTp3Lbl)
            line.delete(_trSlLine)
            _trTp2Line := na
            _trTp2Lbl  := na
            _trTp3Line := na
            _trTp3Lbl  := na
            _trSlLine  := na
        trActive   := false
        _tradeOpen := false
        nClosed    := strategy.closedtrades
    else
        box.set_right(trRisk,   bar_index)
        box.set_right(trProfit, bar_index)

// =============================================================================
// LIMIT ORDERS - Entrada exacta en la TL (intra-bar fill)
// =============================================================================
// En vez de market en el close de la barra de rechazo, colocamos limit
// pendiente en el precio de la TL. Si el precio toca la linea durante una
// barra futura, el fill ocurre EN LA LINEA, no en el close de la barra.
// La caja del trade arranca exactamente en strategy.position_avg_price.

int MAX_PEND_BARS = 8     // bars de vida maxima de orden pendiente sin fill

// Estado de ordenes pendientes (precios + bar de colocacion)
var float _pL_e    = float(na)   // LONG TL: precio limit
var float _pL_sl   = float(na)
var float _pL_tp   = float(na)
var float _pL_qty  = float(na)
var int   _pL_bar  = int(na)

var float _pS_e    = float(na)   // SHORT TL
var float _pS_sl   = float(na)
var float _pS_tp   = float(na)
var float _pS_qty  = float(na)
var int   _pS_bar  = int(na)

var float _pBKL_e   = float(na)   // LONG BK
var float _pBKL_sl  = float(na)
var float _pBKL_tp  = float(na)
var float _pBKL_qty = float(na)
var int   _pBKL_bar = int(na)

var float _pBKS_e   = float(na)   // SHORT BK
var float _pBKS_sl  = float(na)
var float _pBKS_tp  = float(na)
var float _pBKS_qty = float(na)
var int   _pBKS_bar = int(na)

// SL minimo para limit orders: 0.7 ATR debajo/arriba de la linea
// (i_slBuf=0.3 era muy ajustado para entrada exacta en la linea, caza-stops)
float _slBufLim = math.max(i_slBuf, 0.7)

// =============================================================================
// MEJORA #1: 3-slot picker (linea mas cercana entre 1B/2B/3B)
// =============================================================================
// Si la 1B/1A se aleja del precio, agarra automaticamente 2B/3B (la cercana valida).
// Asi evitamos perder retests de lineas secundarias activas.
// (Solo aplica a TL regular, no a BK que tiene un solo slot.)

f_nearestAbove(float price, float l1, int s1, float l2, int s2, float l3, int s3, int minSc) =>
    float best   = float(na)
    int   bestSc = 0
    if not na(l1) and l1 > price and s1 >= minSc
        best   := l1
        bestSc := s1
    if not na(l2) and l2 > price and s2 >= minSc and (na(best) or l2 < best)
        best   := l2
        bestSc := s2
    if not na(l3) and l3 > price and s3 >= minSc and (na(best) or l3 < best)
        best   := l3
        bestSc := s3
    [best, bestSc]

f_nearestBelow(float price, float l1, int s1, float l2, int s2, float l3, int s3, int minSc) =>
    float best   = float(na)
    int   bestSc = 0
    if not na(l1) and l1 < price and s1 >= minSc
        best   := l1
        bestSc := s1
    if not na(l2) and l2 < price and s2 >= minSc and (na(best) or l2 > best)
        best   := l2
        bestSc := s2
    if not na(l3) and l3 < price and s3 >= minSc and (na(best) or l3 > best)
        best   := l3
        bestSc := s3
    [best, bestSc]

// Linea mas cercana arriba (para SHORT setup) y abajo (para LONG setup)
[_lineShortTL, _scShortTL] = f_nearestAbove(close, _curH_now, _scH_cur, _prvH_now, _scH_prv, _oldH_now, _scH_old, i_minTouches)
[_lineLongTL,  _scLongTL]  = f_nearestBelow(close, _curL_now, _scL_cur, _prvL_now, _scL_prv, _oldL_now, _scL_old, i_minTouches)

// === LONG TL: limit en linea de soporte mas cercana ABAJO (entre 1A/2A/3A) ===
bool _favLongTL = (not na(_lineLongTL)
                   and _bullScore >= i_minScore
                   and _sesOK and _inTradeHours
                   and not _tradeOpen
                   and strategy.position_size == 0
                   and close > _lineLongTL
                   and (close - _lineLongTL) <= atrVal * 3.0)

if _favLongTL
    float _eTgt   = _lineLongTL + atrVal * 0.05
    float _slTgt  = _lineLongTL - atrVal * _slBufLim
    float _slD    = _eTgt - _slTgt
    float _qtyTgt = i_riskUSD / _slD
    float _maxD   = atrVal * i_maxTpAtr
    float _tpStr  = i_useStructTP ? f_structTPLong(_eTgt, _slD, tlH_now, htf1H_now, htf2H_now, atrVal * i_tpStructBuf, i_minStructRR, _maxD) : float(na)
    float _tp2    = _eTgt + _slD * 2
    float _tpTgt  = na(_tpStr) ? _tp2 : _tpStr
    if (_tpTgt - _eTgt) > _maxD
        _tpTgt := _eTgt + _maxD
    if (_tpTgt - _eTgt) >= _slD * i_minRRentry
        if na(_pL_bar)
            _pL_bar := bar_index
        _pL_e   := _eTgt
        _pL_sl  := _slTgt
        _pL_tp  := _tpTgt
        _pL_qty := _qtyTgt
        strategy.entry("LONG-L", strategy.long, qty=_qtyTgt, limit=_eTgt)
        strategy.exit("LONG-LX", "LONG-L", stop=_slTgt, limit=_tpTgt)
    else if not na(_pL_bar)
        strategy.cancel("LONG-L")
        _pL_e := na
        _pL_sl := na
        _pL_tp := na
        _pL_qty := na
        _pL_bar := na
else if not na(_pL_bar) and strategy.position_size == 0
    // Solo cancelar si NO se lleno (sino fill detection necesita el estado)
    strategy.cancel("LONG-L")
    _pL_e := na
    _pL_sl := na
    _pL_tp := na
    _pL_qty := na
    _pL_bar := na

if not na(_pL_bar) and (bar_index - _pL_bar) > MAX_PEND_BARS and strategy.position_size == 0
    strategy.cancel("LONG-L")
    _pL_e := na
    _pL_sl := na
    _pL_tp := na
    _pL_qty := na
    _pL_bar := na

// === SHORT TL: limit en linea de resistencia mas cercana ARRIBA (entre 1B/2B/3B) ===
bool _favShortTL = (not na(_lineShortTL)
                    and _bearScore >= i_minScore
                    and _sesOK and _inTradeHours
                    and not _tradeOpen
                    and strategy.position_size == 0
                    and close < _lineShortTL
                    and (_lineShortTL - close) <= atrVal * 3.0)

if _favShortTL
    float _eTgt   = _lineShortTL - atrVal * 0.05
    float _slTgt  = _lineShortTL + atrVal * _slBufLim
    float _slD    = _slTgt - _eTgt
    float _qtyTgt = i_riskUSD / _slD
    float _maxD   = atrVal * i_maxTpAtr
    float _tpStr  = i_useStructTP ? f_structTPShort(_eTgt, _slD, tlL_now, htf1L_now, htf2L_now, atrVal * i_tpStructBuf, i_minStructRR, _maxD) : float(na)
    float _tp2    = _eTgt - _slD * 2
    float _tpTgt  = na(_tpStr) ? _tp2 : _tpStr
    if (_eTgt - _tpTgt) > _maxD
        _tpTgt := _eTgt - _maxD
    if (_eTgt - _tpTgt) >= _slD * i_minRRentry
        if na(_pS_bar)
            _pS_bar := bar_index
        _pS_e   := _eTgt
        _pS_sl  := _slTgt
        _pS_tp  := _tpTgt
        _pS_qty := _qtyTgt
        strategy.entry("SHORT-L", strategy.short, qty=_qtyTgt, limit=_eTgt)
        strategy.exit("SHORT-LX", "SHORT-L", stop=_slTgt, limit=_tpTgt)
    else if not na(_pS_bar)
        strategy.cancel("SHORT-L")
        _pS_e := na
        _pS_sl := na
        _pS_tp := na
        _pS_qty := na
        _pS_bar := na
else if not na(_pS_bar) and strategy.position_size == 0
    strategy.cancel("SHORT-L")
    _pS_e := na
    _pS_sl := na
    _pS_tp := na
    _pS_qty := na
    _pS_bar := na

if not na(_pS_bar) and (bar_index - _pS_bar) > MAX_PEND_BARS and strategy.position_size == 0
    strategy.cancel("SHORT-L")
    _pS_e := na
    _pS_sl := na
    _pS_tp := na
    _pS_qty := na
    _pS_bar := na

// === LONG BK: limit en tlBK_now (linea bajista rota, retest como soporte) ===
bool _favLongBK = (not na(tlBK_now) and _bkIsH
                   and _bkFilter
                   and _sesOK and _inTradeHours
                   and not _tradeOpen
                   and strategy.position_size == 0
                   and close > tlBK_now
                   and (close - tlBK_now) <= atrVal * 3.0)

if _favLongBK
    float _eTgt   = tlBK_now + atrVal * 0.05
    float _slTgt  = tlBK_now - atrVal * _slBufLim
    float _slD    = _eTgt - _slTgt
    float _qtyTgt = i_riskUSD / _slD
    float _maxD   = atrVal * i_maxTpAtr
    float _tpStr  = i_useStructTP ? f_structTPLong(_eTgt, _slD, tlH_now, htf1H_now, htf2H_now, atrVal * i_tpStructBuf, i_minStructRR, _maxD) : float(na)
    float _tp2    = _eTgt + _slD * 2
    float _tpTgt  = na(_tpStr) ? _tp2 : _tpStr
    if (_tpTgt - _eTgt) > _maxD
        _tpTgt := _eTgt + _maxD
    if (_tpTgt - _eTgt) >= _slD * i_minRRentry
        if na(_pBKL_bar)
            _pBKL_bar := bar_index
        _pBKL_e   := _eTgt
        _pBKL_sl  := _slTgt
        _pBKL_tp  := _tpTgt
        _pBKL_qty := _qtyTgt
        strategy.entry("LONG-BKL", strategy.long, qty=_qtyTgt, limit=_eTgt)
        strategy.exit("LONG-BKLX", "LONG-BKL", stop=_slTgt, limit=_tpTgt)
    else if not na(_pBKL_bar)
        strategy.cancel("LONG-BKL")
        _pBKL_e := na
        _pBKL_sl := na
        _pBKL_tp := na
        _pBKL_qty := na
        _pBKL_bar := na
else if not na(_pBKL_bar) and strategy.position_size == 0
    strategy.cancel("LONG-BKL")
    _pBKL_e := na
    _pBKL_sl := na
    _pBKL_tp := na
    _pBKL_qty := na
    _pBKL_bar := na

if not na(_pBKL_bar) and (bar_index - _pBKL_bar) > MAX_PEND_BARS and strategy.position_size == 0
    strategy.cancel("LONG-BKL")
    _pBKL_e := na
    _pBKL_sl := na
    _pBKL_tp := na
    _pBKL_qty := na
    _pBKL_bar := na

// === SHORT BK: limit en tlBK_now (linea alcista rota, retest como resistencia) ===
bool _favShortBK = (not na(tlBK_now) and not _bkIsH
                    and _bkFilter
                    and _sesOK and _inTradeHours
                    and not _tradeOpen
                    and strategy.position_size == 0
                    and close < tlBK_now
                    and (tlBK_now - close) <= atrVal * 3.0)

if _favShortBK
    float _eTgt   = tlBK_now - atrVal * 0.05
    float _slTgt  = tlBK_now + atrVal * _slBufLim
    float _slD    = _slTgt - _eTgt
    float _qtyTgt = i_riskUSD / _slD
    float _maxD   = atrVal * i_maxTpAtr
    float _tpStr  = i_useStructTP ? f_structTPShort(_eTgt, _slD, tlL_now, htf1L_now, htf2L_now, atrVal * i_tpStructBuf, i_minStructRR, _maxD) : float(na)
    float _tp2    = _eTgt - _slD * 2
    float _tpTgt  = na(_tpStr) ? _tp2 : _tpStr
    if (_eTgt - _tpTgt) > _maxD
        _tpTgt := _eTgt - _maxD
    if (_eTgt - _tpTgt) >= _slD * i_minRRentry
        if na(_pBKS_bar)
            _pBKS_bar := bar_index
        _pBKS_e   := _eTgt
        _pBKS_sl  := _slTgt
        _pBKS_tp  := _tpTgt
        _pBKS_qty := _qtyTgt
        strategy.entry("SHORT-BKL", strategy.short, qty=_qtyTgt, limit=_eTgt)
        strategy.exit("SHORT-BKLX", "SHORT-BKL", stop=_slTgt, limit=_tpTgt)
    else if not na(_pBKS_bar)
        strategy.cancel("SHORT-BKL")
        _pBKS_e := na
        _pBKS_sl := na
        _pBKS_tp := na
        _pBKS_qty := na
        _pBKS_bar := na
else if not na(_pBKS_bar) and strategy.position_size == 0
    strategy.cancel("SHORT-BKL")
    _pBKS_e := na
    _pBKS_sl := na
    _pBKS_tp := na
    _pBKS_qty := na
    _pBKS_bar := na

if not na(_pBKS_bar) and (bar_index - _pBKS_bar) > MAX_PEND_BARS and strategy.position_size == 0
    strategy.cancel("SHORT-BKL")
    _pBKS_e := na
    _pBKS_sl := na
    _pBKS_tp := na
    _pBKS_qty := na
    _pBKS_bar := na

// =============================================================================
// FILL DETECTION + VISUALIZATION
// =============================================================================
// Detecta cuando una orden limit se llena (position_size pasa de 0 a non-zero)
// y dibuja todas las cajas/lineas/labels en el precio REAL del fill
// (strategy.position_avg_price), no en el target estimado.

bool _justFilled = strategy.position_size != 0 and strategy.position_size[1] == 0 and not trActive

if _justFilled
    bool   _isLong  = strategy.position_size > 0
    float  _eFill   = strategy.position_avg_price
    float  _slUsed  = float(na)
    float  _tpUsed  = float(na)
    string _typ     = ""
    // Identificar cual orden se lleno (solo una puede estar pendiente al mismo tiempo)
    if _isLong
        if not na(_pL_e)
            _slUsed := _pL_sl
            _tpUsed := _pL_tp
            _typ    := "LONG"
        else if not na(_pBKL_e)
            _slUsed := _pBKL_sl
            _tpUsed := _pBKL_tp
            _typ    := "LONG-BK"
    else
        if not na(_pS_e)
            _slUsed := _pS_sl
            _tpUsed := _pS_tp
            _typ    := "SHORT"
        else if not na(_pBKS_e)
            _slUsed := _pBKS_sl
            _tpUsed := _pBKS_tp
            _typ    := "SHORT-BK"

    if not na(_eFill) and not na(_slUsed) and not na(_tpUsed)
        // Recalcular distancias usando el precio REAL de fill
        float _slDistAbs = math.abs(_eFill - _slUsed)
        float _tp2Ref    = _isLong ? _eFill + _slDistAbs * 2 : _eFill - _slDistAbs * 2
        float _tp3Ref    = _isLong ? _eFill + _slDistAbs * 3 : _eFill - _slDistAbs * 3

        trActive   := true
        _tradeOpen := true
        trSL       := _slUsed
        trTP       := _tpUsed
        trLong     := _isLong
        trEntry    := _eFill
        trEntryBar := bar_index

        string _ses = _inLD ? "LD" : (_inNY ? "NY" : "---")

        // Cajas R/R: arrancan en _eFill (precio real de fill, no estimacion)
        if _isLong
            trRisk   := box.new(bar_index, _eFill, bar_index + 1, _slUsed,
                                border_color=color.white,  bgcolor=color.new(color.white, 85))
            trProfit := box.new(bar_index, _tpUsed, bar_index + 1, _eFill,
                                border_color=#9B59B6, bgcolor=color.new(#9B59B6, 85))
        else
            trRisk   := box.new(bar_index, _slUsed, bar_index + 1, _eFill,
                                border_color=color.white,  bgcolor=color.new(color.white, 85))
            trProfit := box.new(bar_index, _eFill,  bar_index + 1, _tpUsed,
                                border_color=#9B59B6, bgcolor=color.new(#9B59B6, 85))

        // Cleanup de elementos visuales del trade anterior
        line.delete(_trSlLine)
        line.delete(_trTp2Line)
        line.delete(_trTp3Line)
        label.delete(_trTp2Lbl)
        label.delete(_trTp3Lbl)

        // Probability label
        int _scU = _isLong ? _bullScore : _bearScore
        [_pt, _pc] = f_prob(_scU)
        _trProbLbl := label.new(bar_index, _isLong ? _slUsed - atrVal * 0.6 : _slUsed + atrVal * 0.6,
                        "[" + _pt + "  " + str.tostring(_scU) + "]",
                        style=_isLong ? label.style_label_up : label.style_label_down,
                        color=color.new(_pc, 30), textcolor=color.white, size=size.tiny)

        // SL line
        _trSlLine  := line.new(bar_index, _slUsed, bar_index + 4, _slUsed,
                        color=color.new(color.red, 50), width=1)

        // TP 1:2 reference (visual marker en multiplo R fijo)
        _trTp2Line := line.new(bar_index, _tp2Ref, bar_index + 25, _tp2Ref,
                        color=color.new(#26A69A, 40), width=2)
        _trTp2Lbl  := label.new(bar_index + 12, _tp2Ref,
                        "TP 1:2  $" + str.tostring(math.round(i_riskUSD * 2)),
                        style=label.style_label_center,
                        color=color.new(#26A69A, 45), textcolor=color.white, size=size.tiny)

        // TP 1:3 reference
        _trTp3Line := line.new(bar_index, _tp3Ref, bar_index + 38, _tp3Ref,
                        color=color.new(#26A69A, 65), width=1, style=line.style_dashed)
        _trTp3Lbl  := label.new(bar_index + 19, _tp3Ref,
                        "TP 1:3  $" + str.tostring(math.round(i_riskUSD * 3)),
                        style=label.style_label_center,
                        color=color.new(#26A69A, 65), textcolor=color.white, size=size.tiny)

        // Backtesting label con precio REAL de fill
        if i_backtesting
            label _lbl = label.new(bar_index, _isLong ? _slUsed - atrVal * 0.3 : _slUsed + atrVal * 0.3,
                          _typ + "  Ses: " + _ses +
                          "\nE: "   + str.tostring(_eFill,  format.mintick) +
                          "  SL: " + str.tostring(_slUsed, format.mintick) +
                          "\nRiesgo: $"  + str.tostring(math.round(i_riskUSD)) +
                          "  Profit 1:2: $" + str.tostring(math.round(i_riskUSD * 2)),
                          style=_isLong ? label.style_label_up : label.style_label_down,
                          color=color.new(_isLong ? i_colL : i_colH, 10),
                          textcolor=color.white, size=size.small)

    // Cancelar TODAS las ordenes pendientes (la que se lleno ya no existe, las otras 3 podrian flipearnos)
    strategy.cancel("LONG-L")
    strategy.cancel("SHORT-L")
    strategy.cancel("LONG-BKL")
    strategy.cancel("SHORT-BKL")
    // Limpiar estado interno
    _pL_e := na
    _pL_sl := na
    _pL_tp := na
    _pL_qty := na
    _pL_bar := na
    _pS_e := na
    _pS_sl := na
    _pS_tp := na
    _pS_qty := na
    _pS_bar := na
    _pBKL_e := na
    _pBKL_sl := na
    _pBKL_tp := na
    _pBKL_qty := na
    _pBKL_bar := na
    _pBKS_e := na
    _pBKS_sl := na
    _pBKS_tp := na
    _pBKS_qty := na
    _pBKS_bar := na

// =============================================================================
// ALERTAS
// =============================================================================
alertcondition(bearSig,   "SHORT    - Pivote en TL resistencia",
               "Pivote alto confirmado sobre trendline de resistencia.")
alertcondition(bullSig,   "LONG     - Pivote en TL soporte",
               "Pivote bajo confirmado sobre trendline de soporte.")
alertcondition(bkBearSig, "SHORT-BK - Retest de B rota como resistencia",
               "Precio retestea desde arriba una trendline bajista que fue rota al alza.")
alertcondition(bkBullSig, "LONG-BK  - Retest de A rota como soporte",
               "Precio retestea desde abajo una trendline alcista que fue rota a la baja.")
