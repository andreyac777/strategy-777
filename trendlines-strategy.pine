//@version=6
strategy("TL Rejections - MTF", shorttitle="TLS", overlay=true,
         max_lines_count=500, max_boxes_count=500, max_labels_count=500,
         initial_capital=1000000, currency=currency.USD,
         default_qty_type=strategy.fixed, default_qty_value=1,
         process_orders_on_close=true)

// =============================================================================
// INPUTS
// =============================================================================
var GRP_PIV = "Trendlines"
i_pivPer     = input.int(10, "Periodo del pivote",        minval=3,  maxval=50,   group=GRP_PIV,
               tooltip="Barras a cada lado para confirmar un maximo/minimo estructural")
i_nPiv       = input.int(10, "Pivotes a analizar",        minval=4,  maxval=12,   group=GRP_PIV,
               tooltip="Cuantos pivotes recientes se evaluan para el best-fit")
i_minTouches = input.int(3,  "Toques minimos para entrar", minval=2, maxval=6,    group=GRP_PIV,
               tooltip="La trendline necesita al menos N pivotes confirmados para ser valida. 3 recomendado.")
i_atrMult    = input.float(0.5, "Tolerancia de toque (xATR)", minval=0.1, maxval=2.0, step=0.1, group=GRP_PIV,
               tooltip="Ventana alrededor de la trendline para detectar el toque")
i_wickRatio  = input.float(0.25, "Wick minimo (wick/rango)", minval=0.10, maxval=0.80, step=0.05, group=GRP_PIV,
               tooltip="Fraccion del rango de la vela que debe ser mecha de rechazo. 0.25 recomendado.")
i_minSpacing = input.int(20, "Min barras entre toques", minval=3, maxval=100, group=GRP_PIV,
               tooltip="Barras minimas entre dos toques validos de la misma TL. Evita que una consolidacion infle el score. 20 barras = 100 min en 5m.")
i_minSpreadATR  = input.float(2.0, "Spread min B-A para BK (xATR)", minval=0.5, maxval=10.0, step=0.5, group=GRP_PIV,
               tooltip="Filtro secundario de consolidacion para senales BK. Si la pendiente no clasifica, se requiere este spread minimo entre 1B y 1A.")
i_bkConfirmBars = input.int(3, "Barras confirmacion break", minval=2, maxval=10, group=GRP_PIV,
               tooltip="Barras consecutivas que debe cerrar mas alla de la TL para validar el break. 2 = posible Judas, 3+ = break real.")
i_bkMinATR      = input.float(0.3, "Distancia minima break (xATR)", minval=0.1, maxval=3.0, step=0.1, group=GRP_PIV,
               tooltip="El cierre debe estar al menos N*ATR mas alla de la TL para contar como barra de break.")
i_bkDupATR      = input.float(0.5, "Tolerancia BK duplicada (xATR)", minval=0.0, maxval=3.0, step=0.1, group=GRP_PIV,
               tooltip="Si la nueva BK proyecta dentro de N*ATR de la BK actual, se considera la misma tendencia y NO se crea duplicado. 0 = desactivar guard.")
i_bkJudasBars   = input.int(8, "Barras vigilancia Judas", minval=2, maxval=30, group=GRP_PIV,
               tooltip="Barras post-break en las que se vigila si el precio retorna al lado original. Si retorna, la BK se invalida y se etiqueta JUDAS.")
i_bkJudasATR    = input.float(0.3, "Distancia retorno Judas (xATR)", minval=0.1, maxval=3.0, step=0.1, group=GRP_PIV,
               tooltip="Si dentro de la ventana, el precio cierra a esta distancia del lado original de la BK, se considera Judas y se invalida.")
i_bkMinTouches  = input.int(3, "Toques minimos de TL para promover a BK", minval=2, maxval=6, group=GRP_PIV,
               tooltip="Una TL solo puede ser rota y promovida a BK si tenia al menos N toques. Evita que TLs estructuralmente debiles (recien formadas con 2 anclajes) generen BKs prematuras. Recomendado: igual a 'Toques minimos para entrar'.")

var GRP_HTF = "Confluencia HTF"
i_htf1TF     = input.timeframe("60",  "HTF1 - Timeframe",             group=GRP_HTF)
i_htf1Period = input.int(5,  "HTF1 - Periodo pivote", minval=2, maxval=20, group=GRP_HTF)
i_htf2TF     = input.timeframe("240", "HTF2 - Timeframe",             group=GRP_HTF)
i_htf2Period = input.int(5,  "HTF2 - Periodo pivote", minval=2, maxval=20, group=GRP_HTF)
i_htfTol     = input.float(1.5, "Tolerancia confluencia HTF (xATR)", minval=0.5, maxval=4.0, step=0.5, group=GRP_HTF)
i_minScore   = input.int(0,  "Score minimo para entrar", minval=0, maxval=6, group=GRP_HTF,
               tooltip="HTF2 +2, HTF1 +1, LD +1, NY +1, TF actual >=4 toques +1. Max=6. 0 = sin filtro.")

var GRP_SES = "Sesiones"
i_asiaStartH = input.int(0,  "Asia - Inicio UTC", minval=0, maxval=23, group=GRP_SES)
i_asiaEndH   = input.int(7,  "Asia - Fin UTC",    minval=0, maxval=23, group=GRP_SES)
i_ldStartH   = input.int(7,  "LD   - Inicio UTC", minval=0, maxval=23, group=GRP_SES)
i_ldEndH     = input.int(12, "LD   - Fin UTC",    minval=0, maxval=23, group=GRP_SES)
i_nyStartH   = input.int(12, "NY   - Inicio UTC", minval=0, maxval=23, group=GRP_SES)
i_nyEndH     = input.int(17, "NY   - Fin UTC",    minval=0, maxval=23, group=GRP_SES)
i_showSesLbl = input.bool(true, "Etiquetas de sesion", group=GRP_SES)
i_filterSes  = input.string("LD+NY", "Sesion para senales",
               options=["Todas", "LD", "NY", "LD+NY"], group=GRP_SES)
i_tradeStart = input.int(13, "Horario operativo - Inicio (UTC)", minval=0, maxval=23, group=GRP_SES,
               tooltip="UTC-6: 7am local = 13 UTC | UTC-5: 7am = 12 UTC")
i_tradeEnd   = input.int(17, "Horario operativo - Fin    (UTC)", minval=0, maxval=23, group=GRP_SES,
               tooltip="UTC-6: 11am local = 17 UTC")

var GRP_RISK = "Gestion de Riesgo"
i_riskUSD    = input.float(60.0, "Riesgo fijo por operacion (USD)", minval=1.0, step=5.0, group=GRP_RISK)
i_slBuf      = input.float(0.3,  "SL buffer (xATR sobre el pivote)", minval=0.0, maxval=3.0, step=0.1, group=GRP_RISK)
i_backtesting = input.bool(false, "Mostrar etiquetas (backtesting)", group=GRP_RISK)

var GRP_VIS = "Visual"
i_colH    = input.color(#00bfff, "Color resistencia (B)",  group=GRP_VIS)
i_colL    = input.color(#CE93D8, "Color soporte (A)",     group=GRP_VIS)
i_colBK   = input.color(#ff5252, "Color break (BK)",      group=GRP_VIS)
i_colAsia = input.color(color.new(color.white, 90), "Asia fondo", group=GRP_VIS)
i_colLD   = input.color(color.new(#9B59B6, 87),     "LD fondo",   group=GRP_VIS)
i_colNY    = input.color(color.new(#00EFEF, 90),     "NY fondo",        group=GRP_VIS)
i_colHTF1H = input.color(color.new(#CE93D8,  0),    "HTF1 resistencia", group=GRP_VIS)
i_colHTF1L = input.color(color.new(#CE93D8,  0),    "HTF1 soporte",     group=GRP_VIS)
i_colHTF2H = input.color(color.new(#9B59B6,  0),    "HTF2 resistencia", group=GRP_VIS)
i_colHTF2L = input.color(color.new(#FFFFFF,  0),    "HTF2 soporte",     group=GRP_VIS)

// =============================================================================
// SESIONES
// =============================================================================
int _utcH = math.floor(time / 3600000) % 24

f_inSes(int s, int e) =>
    (s < e ? (_utcH >= s and _utcH < e) : (_utcH >= s or _utcH < e))

bool _inAsia = f_inSes(i_asiaStartH, i_asiaEndH)
bool _inLD   = f_inSes(i_ldStartH,   i_ldEndH)
bool _inNY   = f_inSes(i_nyStartH,   i_nyEndH)

bool _asiaOpen = _inAsia and not _inAsia[1]
bool _ldOpen   = _inLD   and not _inLD[1]
bool _nyOpen   = _inNY   and not _inNY[1]

var float _asiaH = float(na), var float _asiaL = float(na)
var float _ldH   = float(na), var float _ldL   = float(na)
var float _nyH   = float(na), var float _nyL   = float(na)

if _asiaOpen
    _asiaH := high
    _asiaL := low
if _inAsia
    _asiaH := math.max(_asiaH, high)
    _asiaL := math.min(_asiaL, low)

if _ldOpen
    _ldH := high
    _ldL := low
if _inLD
    _ldH := math.max(_ldH, high)
    _ldL := math.min(_ldL, low)

if _nyOpen
    _nyH := high
    _nyL := low
if _inNY
    _nyH := math.max(_nyH, high)
    _nyL := math.min(_nyL, low)

var box _bAsia = na
var box _bLD   = na
var box _bNY   = na

if _asiaOpen
    _bAsia := box.new(bar_index, high, bar_index, low,
                      border_color=color.new(color.white, 75), bgcolor=i_colAsia)
if _inAsia and not na(_bAsia)
    box.set_right(_bAsia,  bar_index)
    box.set_top(_bAsia,    _asiaH)
    box.set_bottom(_bAsia, _asiaL)

if _ldOpen
    _bLD := box.new(bar_index, high, bar_index, low,
                    border_color=color.new(#9B59B6, 55), bgcolor=i_colLD)
if _inLD and not na(_bLD)
    box.set_right(_bLD,  bar_index)
    box.set_top(_bLD,    _ldH)
    box.set_bottom(_bLD, _ldL)

if _nyOpen
    _bNY := box.new(bar_index, high, bar_index, low,
                    border_color=color.new(#00AAAA, 55), bgcolor=i_colNY)
if _inNY and not na(_bNY)
    box.set_right(_bNY,  bar_index)
    box.set_top(_bNY,    _nyH)
    box.set_bottom(_bNY, _nyL)

if i_showSesLbl
    if _asiaOpen
        label _la = label.new(bar_index, high, "Asia", style=label.style_label_down,
                     color=color.new(color.white, 60), textcolor=color.gray, size=size.tiny)
    if _ldOpen
        label _ll = label.new(bar_index, high, "LD", style=label.style_label_down,
                     color=color.new(#9B59B6, 40), textcolor=color.white, size=size.tiny)
    if _nyOpen
        label _ln = label.new(bar_index, high, "NY", style=label.style_label_down,
                     color=color.new(#00AAAA, 40), textcolor=color.white, size=size.tiny)

bool _sesOK       = switch i_filterSes
    "LD"    => _inLD
    "NY"    => _inNY
    "LD+NY" => _inLD or _inNY
    =>         true
bool _inTradeHours = _utcH >= i_tradeStart and _utcH < i_tradeEnd

// =============================================================================
// PIVOTES Y TRENDLINES (best-fit, igual que trendlines.pine)
// =============================================================================
float atrVal = ta.atr(14)
float _tol   = atrVal * i_atrMult

float pivH = ta.pivothigh(high, i_pivPer, i_pivPer)
float pivL = ta.pivotlow(low,   i_pivPer, i_pivPer)

var int[]   _pH_b = array.new_int(12,   int(na))
var float[] _pH_v = array.new_float(12, float(na))
var int[]   _pL_b = array.new_int(12,   int(na))
var float[] _pL_v = array.new_float(12, float(na))

// Sistema de 2 slots por direccion: cur = TL mas reciente, prv = TL anterior
// cur empieza tenue y se vuelve solida con toques; prv se desvanece conforme cur gana toques
var line  _tlH_cur = na,          var line  _tlH_prv = na
var int   _scH_cur = 0,           var int   _scH_prv = 0
var int   _b1H_cur = int(na),     var float _v1H_cur = float(na)
var int   _b2H_cur = int(na),     var float _v2H_cur = float(na)
var int   _b1H_prv = int(na),     var float _v1H_prv = float(na)
var int   _b2H_prv = int(na),     var float _v2H_prv = float(na)
var line  _tlL_cur = na,          var line  _tlL_prv = na
var int   _scL_cur = 0,           var int   _scL_prv = 0
var int   _b1L_cur = int(na),     var float _v1L_cur = float(na)
var int   _b2L_cur = int(na),     var float _v2L_cur = float(na)
var int   _b1L_prv = int(na),     var float _v1L_prv = float(na)
var int   _b2L_prv = int(na),     var float _v2L_prv = float(na)
var int   _tlH_score = 0
var int   _tlL_score = 0
var label _lbl1B = na,   var label _lbl1A = na
var label _lbl2B = na,   var label _lbl2A = na
var label _dbgH  = na,   var label _dbgL  = na
var label _lblH1B = na,  var label _lblH1A = na
var label _lblH4B = na,  var label _lblH4A = na
var label _lbl1BK = na,  var label _lbl2BK = na

// BK: TL rota usada como soporte/resistencia (role reversal)
var line  _tlBK_cur = na,      var line  _tlBK_prv = na
var int   _scBK_cur = 0,       var int   _scBK_prv = 0
var int   _b1BK_cur = int(na), var float _v1BK_cur = float(na)
var int   _b2BK_cur = int(na), var float _v2BK_cur = float(na)
var int   _b1BK_prv = int(na), var float _v1BK_prv = float(na)
var int   _b2BK_prv = int(na), var float _v2BK_prv = float(na)
var bool  _bkFromH_cur = false  // true = B rota -> LONG retest | false = A rota -> SHORT retest
var bool  _bkFromH_prv = false
var bool  _bkSlope_cur = false  // pendiente confirma tendencia en el momento del break
var bool  _bkSlope_prv = false
var int   _tlBK_score  = 0
// debounce: evita registrar el mismo break dos veces
var int   _bkH_src_b2  = int(na)
var int   _bkL_src_b2  = int(na)
// Ventana de vigilancia Judas - bar_index hasta el cual la BK actual sigue en evaluacion
var int   _bk_judas_until = int(na)
// contadores de barras consecutivas con cierre mas alla de la TL
var int   _bkH_cnt_cur = 0
var int   _bkH_cnt_prv = 0
var int   _bkL_cnt_cur = 0
var int   _bkL_cnt_prv = 0
// tracking de cual slot H/L esta activo para senales
var bool  _tlH_from_prv = false
var bool  _tlL_from_prv = false

f_push(int[] bars, float[] vals, int b, float v) =>
    array.shift(bars)
    array.push(bars, b)
    array.shift(vals)
    array.push(vals, v)

f_bestFit(int[] bars, float[] vals, float ftol, int nPiv, int minSpacing) =>
    int   N    = 12
    int   from = N - nPiv
    int   bestB1 = int(na),   bestB2 = int(na)
    float bestV1 = float(na), bestV2 = float(na)
    int   bestScore = -1
    for i = from to N - 2
        int   bi = array.get(bars, i)
        float vi = array.get(vals, i)
        if na(bi)
            continue
        for j = i + 1 to N - 1
            int   bj = array.get(bars, j)
            float vj = array.get(vals, j)
            if na(bj) or bi == bj
                continue
            float sl        = (vj - vi) / float(bj - bi)
            int   sc        = 0
            int   lastTouch = -9999
            for k = from to N - 1
                int   bk = array.get(bars, k)
                float vk = array.get(vals, k)
                if na(bk)
                    continue
                if math.abs(vk - (vi + sl * float(bk - bi))) <= ftol
                    if bk - lastTouch >= minSpacing
                        sc        += 1
                        lastTouch := bk
            bool newer = na(bestB2) or bj > bestB2
            if sc > bestScore or (sc == bestScore and newer)
                bestScore := sc
                bestB1 := bi
                bestV1 := vi
                bestB2 := bj
                bestV2 := vj
    [bestB1, bestV1, bestB2, bestV2, bestScore]

f_proj(int b1, float v1, int b2, float v2) =>
    (not na(b2) ?
        (not na(b1) and b2 > b1 ?
            v2 + (v2 - v1) / float(b2 - b1) * float(bar_index - b2) :
            v2) :
        float(na))

// Transparencia segun score: sc=1 -> 55%, sc=2 -> 30%, sc=3 -> 5%, sc=4+ -> 0% (solida)
f_tlAlpha(int sc) =>
    math.max(0, 80 - sc * 25)

// =============================================================================
// CONFLUENCIA HTF - trendlines de H1 y H4 proyectadas al bar actual
// =============================================================================

f_tlNow(float p1, int t1, float p2, int t2) =>
    (not na(p2) and not na(t2) ?
        (not na(p1) and not na(t1) and t2 > t1 ?
            p2 + (p2 - p1) / float(t2 - t1) * float(time - t2) :
            p2) :
        float(na))

f_htfH(int per) =>
    float piv = ta.pivothigh(high, per, per)
    bool  hit = not na(piv)
    float v2  = ta.valuewhen(hit, piv,       0)
    int   t2  = ta.valuewhen(hit, time[per], 0)
    float v1  = ta.valuewhen(hit, piv,       1)
    int   t1  = ta.valuewhen(hit, time[per], 1)
    [v2, t2, v1, t1]

f_htfL(int per) =>
    float piv = ta.pivotlow(low, per, per)
    bool  hit = not na(piv)
    float v2  = ta.valuewhen(hit, piv,       0)
    int   t2  = ta.valuewhen(hit, time[per], 0)
    float v1  = ta.valuewhen(hit, piv,       1)
    int   t1  = ta.valuewhen(hit, time[per], 1)
    [v2, t2, v1, t1]

[_h1rP2, _h1rT2, _h1rP1, _h1rT1] = request.security(syminfo.tickerid, i_htf1TF,
    f_htfH(i_htf1Period), lookahead=barmerge.lookahead_off)
[_h1sP2, _h1sT2, _h1sP1, _h1sT1] = request.security(syminfo.tickerid, i_htf1TF,
    f_htfL(i_htf1Period), lookahead=barmerge.lookahead_off)
[_h2rP2, _h2rT2, _h2rP1, _h2rT1] = request.security(syminfo.tickerid, i_htf2TF,
    f_htfH(i_htf2Period), lookahead=barmerge.lookahead_off)
[_h2sP2, _h2sT2, _h2sP1, _h2sT1] = request.security(syminfo.tickerid, i_htf2TF,
    f_htfL(i_htf2Period), lookahead=barmerge.lookahead_off)

float htf1H_now = f_tlNow(_h1rP1, _h1rT1, _h1rP2, _h1rT2)
float htf1L_now = f_tlNow(_h1sP1, _h1sT1, _h1sP2, _h1sT2)
float htf2H_now = f_tlNow(_h2rP1, _h2rT1, _h2rP2, _h2rT2)
float htf2L_now = f_tlNow(_h2sP1, _h2sT1, _h2sP2, _h2sT2)

var line  _htf1H_line = na
var line  _htf1L_line = na
var line  _htf2H_line = na
var line  _htf2L_line = na
var float _prev_h1rP2 = float(na)
var float _prev_h1sP2 = float(na)
var float _prev_h2rP2 = float(na)
var float _prev_h2sP2 = float(na)

if not na(_h1rP2) and not na(_h1rP1) and _h1rP2 != _prev_h1rP2
    line.delete(_htf1H_line)
    _htf1H_line := line.new(_h1rT1, _h1rP1, _h1rT2, _h1rP2,
                            xloc=xloc.bar_time, extend=extend.right,
                            color=i_colHTF1H, width=2, style=line.style_dashed)
    label.delete(_lblH1B)
    _lblH1B := label.new(bar_index + 3, _h1rP2, "H1B",
                         color=color.new(i_colHTF1H, 70), textcolor=i_colHTF1H,
                         style=label.style_label_left, size=size.small)
    _prev_h1rP2 := _h1rP2

if not na(_h1sP2) and not na(_h1sP1) and _h1sP2 != _prev_h1sP2
    line.delete(_htf1L_line)
    _htf1L_line := line.new(_h1sT1, _h1sP1, _h1sT2, _h1sP2,
                            xloc=xloc.bar_time, extend=extend.right,
                            color=i_colHTF1L, width=2, style=line.style_dashed)
    label.delete(_lblH1A)
    _lblH1A := label.new(bar_index + 3, _h1sP2, "H1A",
                         color=color.new(i_colHTF1L, 70), textcolor=i_colHTF1L,
                         style=label.style_label_left, size=size.small)
    _prev_h1sP2 := _h1sP2

if not na(_h2rP2) and not na(_h2rP1) and _h2rP2 != _prev_h2rP2
    line.delete(_htf2H_line)
    _htf2H_line := line.new(_h2rT1, _h2rP1, _h2rT2, _h2rP2,
                            xloc=xloc.bar_time, extend=extend.right,
                            color=i_colHTF2H, width=3, style=line.style_solid)
    label.delete(_lblH4B)
    _lblH4B := label.new(bar_index + 3, _h2rP2, "H4B",
                         color=color.new(i_colHTF2H, 70), textcolor=i_colHTF2H,
                         style=label.style_label_left, size=size.small)
    _prev_h2rP2 := _h2rP2

if not na(_h2sP2) and not na(_h2sP1) and _h2sP2 != _prev_h2sP2
    line.delete(_htf2L_line)
    _htf2L_line := line.new(_h2sT1, _h2sP1, _h2sT2, _h2sP2,
                            xloc=xloc.bar_time, extend=extend.right,
                            color=i_colHTF2L, width=3, style=line.style_solid)
    label.delete(_lblH4A)
    _lblH4A := label.new(bar_index + 3, _h2sP2, "H4A",
                         color=color.new(i_colHTF2L, 70), textcolor=i_colHTF2L,
                         style=label.style_label_left, size=size.small)
    _prev_h2sP2 := _h2sP2

f_scoreBear(float lvl) =>
    float aTol = atrVal * i_htfTol
    int   sc   = 0
    if not na(htf1H_now) and math.abs(lvl - htf1H_now) <= aTol
        sc += 1
    if not na(htf2H_now) and math.abs(lvl - htf2H_now) <= aTol
        sc += 2
    if _inLD
        sc += 1
    if _inNY
        sc += 1
    if _tlH_score >= 4
        sc += 1
    sc

f_scoreBull(float lvl) =>
    float aTol = atrVal * i_htfTol
    int   sc   = 0
    if not na(htf1L_now) and math.abs(lvl - htf1L_now) <= aTol
        sc += 1
    if not na(htf2L_now) and math.abs(lvl - htf2L_now) <= aTol
        sc += 2
    if _inLD
        sc += 1
    if _inNY
        sc += 1
    if _tlL_score >= 4
        sc += 1
    sc

f_prob(int s) =>
    string txt = ""
    color  col = color.gray
    if s >= 5
        txt := "MUY ALTA"
        col := color.new(color.green, 0)
    else if s >= 4
        txt := "ALTA"
        col := color.new(#26A69A, 0)
    else if s >= 3
        txt := "MEDIA-ALTA"
        col := color.new(color.yellow, 0)
    else if s >= 2
        txt := "MEDIA"
        col := color.new(color.orange, 0)
    else
        txt := "BAJA"
        col := color.new(color.red, 20)
    [txt, col]

if not na(pivH)
    f_push(_pH_b, _pH_v, bar_index - i_pivPer, pivH)
    [b1, v1, b2, v2, sc] = f_bestFit(_pH_b, _pH_v, _tol, i_nPiv, i_minSpacing)
    if not na(b1)
        bool _newH = na(_b2H_cur) or b2 != _b2H_cur or b1 != _b1H_cur
        if _newH
            // old prv (2 generaciones) se elimina
            line.delete(_tlH_prv)
            label.delete(_lbl2B)
            // cur se convierte en el nuevo prv (la linea se reutiliza, solo se desvanece)
            _b1H_prv := _b1H_cur,  _v1H_prv := _v1H_cur
            _b2H_prv := _b2H_cur,  _v2H_prv := _v2H_cur
            _scH_prv  := _scH_cur
            _tlH_prv  := _tlH_cur
            if not na(_tlH_prv)
                line.set_color(_tlH_prv, color.new(i_colH, 40))
                line.set_width(_tlH_prv, 1)
                label.delete(_lbl1B)
                _lbl2B := label.new(bar_index + 3, _v2H_prv, "2B",
                                    color=color.new(i_colH, 85), textcolor=i_colH,
                                    style=label.style_label_left, size=size.small)
                _lbl1B := na
            else
                label.delete(_lbl1B)
                _lbl1B  := na
                _lbl2B  := na
            // nueva cur empieza tenue
            _tlH_cur  := line.new(b1, v1, b2, v2,
                                  color=color.new(i_colH, f_tlAlpha(sc)),
                                  width=sc >= i_minTouches ? 2 : 1, extend=extend.right)
            _lbl1B := label.new(bar_index + 3, v2, "1B",
                                color=color.new(i_colH, 70), textcolor=i_colH,
                                style=label.style_label_left, size=size.small)
            _b1H_cur := b1,  _v1H_cur := v1
            _b2H_cur := b2,  _v2H_cur := v2
            _scH_cur  := sc
            _bkH_cnt_prv := _bkH_cnt_cur
            _bkH_cnt_cur := 0
        else
            _scH_cur := sc
            line.set_color(_tlH_cur, color.new(i_colH, f_tlAlpha(sc)))
            line.set_width(_tlH_cur, sc >= i_minTouches ? 2 : 1)
            if not na(_tlH_prv)
                int _aP = math.min(100, 40 + _scH_cur * 20)
                if _aP >= 98
                    line.delete(_tlH_prv)
                    _tlH_prv := na,      _scH_prv := 0
                    _b1H_prv := int(na), _v1H_prv := float(na)
                    _b2H_prv := int(na), _v2H_prv := float(na)
                    label.delete(_lbl2B)
                    _lbl2B := na
                else
                    line.set_color(_tlH_prv, color.new(i_colH, _aP))

if not na(pivL)
    f_push(_pL_b, _pL_v, bar_index - i_pivPer, pivL)
    [b1, v1, b2, v2, sc] = f_bestFit(_pL_b, _pL_v, _tol, i_nPiv, i_minSpacing)
    if not na(b1)
        bool _newL = na(_b2L_cur) or b2 != _b2L_cur or b1 != _b1L_cur
        if _newL
            line.delete(_tlL_prv)
            label.delete(_lbl2A)
            _b1L_prv := _b1L_cur,  _v1L_prv := _v1L_cur
            _b2L_prv := _b2L_cur,  _v2L_prv := _v2L_cur
            _scL_prv  := _scL_cur
            _tlL_prv  := _tlL_cur
            if not na(_tlL_prv)
                line.set_color(_tlL_prv, color.new(i_colL, 40))
                line.set_width(_tlL_prv, 1)
                label.delete(_lbl1A)
                _lbl2A := label.new(bar_index + 3, _v2L_prv, "2A",
                                    color=color.new(i_colL, 85), textcolor=i_colL,
                                    style=label.style_label_left, size=size.small)
                _lbl1A := na
            else
                label.delete(_lbl1A)
                _lbl1A  := na
                _lbl2A  := na
            _tlL_cur  := line.new(b1, v1, b2, v2,
                                  color=color.new(i_colL, f_tlAlpha(sc)),
                                  width=sc >= i_minTouches ? 2 : 1, extend=extend.right)
            _lbl1A := label.new(bar_index + 3, v2, "1A",
                                color=color.new(i_colL, 70), textcolor=i_colL,
                                style=label.style_label_left, size=size.small)
            _b1L_cur := b1,  _v1L_cur := v1
            _b2L_cur := b2,  _v2L_cur := v2
            _scL_cur  := sc
            _bkL_cnt_prv := _bkL_cnt_cur
            _bkL_cnt_cur := 0
        else
            _scL_cur := sc
            line.set_color(_tlL_cur, color.new(i_colL, f_tlAlpha(sc)))
            line.set_width(_tlL_cur, sc >= i_minTouches ? 2 : 1)
            if not na(_tlL_prv)
                int _aP = math.min(100, 40 + _scL_cur * 20)
                if _aP >= 98
                    line.delete(_tlL_prv)
                    _tlL_prv := na,      _scL_prv := 0
                    _b1L_prv := int(na), _v1L_prv := float(na)
                    _b2L_prv := int(na), _v2L_prv := float(na)
                    label.delete(_lbl2A)
                    _lbl2A := na
                else
                    line.set_color(_tlL_prv, color.new(i_colL, _aP))

// Seleccionar la TL mas fuerte disponible (cur o prv) para senales de entrada
_tlH_score := 0
_tlL_score := 0
float _curH_now = f_proj(_b1H_cur, _v1H_cur, _b2H_cur, _v2H_cur)
float _prvH_now = f_proj(_b1H_prv, _v1H_prv, _b2H_prv, _v2H_prv)
float _curL_now = f_proj(_b1L_cur, _v1L_cur, _b2L_cur, _v2L_cur)
float _prvL_now = f_proj(_b1L_prv, _v1L_prv, _b2L_prv, _v2L_prv)

if not na(_lbl1B) and not na(_curH_now)
    label.set_x(_lbl1B, bar_index + 3)
    label.set_y(_lbl1B, _curH_now)
if not na(_lbl2B) and not na(_prvH_now)
    label.set_x(_lbl2B, bar_index + 3)
    label.set_y(_lbl2B, _prvH_now)
if not na(_lbl1A) and not na(_curL_now)
    label.set_x(_lbl1A, bar_index + 3)
    label.set_y(_lbl1A, _curL_now)
if not na(_lbl2A) and not na(_prvL_now)
    label.set_x(_lbl2A, bar_index + 3)
    label.set_y(_lbl2A, _prvL_now)
if not na(_lblH1B) and not na(htf1H_now)
    label.set_x(_lblH1B, bar_index + 3)
    label.set_y(_lblH1B, htf1H_now)
if not na(_lblH1A) and not na(htf1L_now)
    label.set_x(_lblH1A, bar_index + 3)
    label.set_y(_lblH1A, htf1L_now)
if not na(_lblH4B) and not na(htf2H_now)
    label.set_x(_lblH4B, bar_index + 3)
    label.set_y(_lblH4B, htf2H_now)
if not na(_lblH4A) and not na(htf2L_now)
    label.set_x(_lblH4A, bar_index + 3)
    label.set_y(_lblH4A, htf2L_now)
float _bkCurNow = f_proj(_b1BK_cur, _v1BK_cur, _b2BK_cur, _v2BK_cur)
float _bkPrvNow = f_proj(_b1BK_prv, _v1BK_prv, _b2BK_prv, _v2BK_prv)
if not na(_lbl1BK) and not na(_bkCurNow)
    label.set_x(_lbl1BK, bar_index + 3)
    label.set_y(_lbl1BK, _bkCurNow)
if not na(_lbl2BK) and not na(_bkPrvNow)
    label.set_x(_lbl2BK, bar_index + 3)
    label.set_y(_lbl2BK, _bkPrvNow)

float tlH_now = float(na)
float tlL_now = float(na)

_tlH_from_prv := false
_tlL_from_prv := false

if _scH_cur >= i_minTouches and not na(_curH_now)
    if not na(_prvH_now) and _scH_prv > _scH_cur
        tlH_now := _prvH_now
        _tlH_score := _scH_prv
        _tlH_from_prv := true
    else
        tlH_now := _curH_now
        _tlH_score := _scH_cur
else if _scH_prv >= i_minTouches and not na(_prvH_now)
    tlH_now := _prvH_now
    _tlH_score := _scH_prv
    _tlH_from_prv := true

if _scL_cur >= i_minTouches and not na(_curL_now)
    if not na(_prvL_now) and _scL_prv > _scL_cur
        tlL_now := _prvL_now
        _tlL_score := _scL_prv
        _tlL_from_prv := true
    else
        tlL_now := _curL_now
        _tlL_score := _scL_cur
else if _scL_prv >= i_minTouches and not na(_prvL_now)
    tlL_now := _prvL_now
    _tlL_score := _scL_prv
    _tlL_from_prv := true

// =============================================================================
// BREAK DETECTION - TL rota se convierte en linea BK (role reversal)
// Break valido: cierre mas alla de la TL por i_bkMinATR*ATR durante i_bkConfirmBars barras consecutivas
// Judas swing: break de 1-2 velas ignorado (contador no alcanza el umbral)
// =============================================================================
float _bkMinDist = i_bkMinATR * atrVal

// Actualizar contadores de barras consecutivas mas alla de cada slot
if not na(_curH_now) and close > _curH_now + _bkMinDist
    _bkH_cnt_cur += 1
else
    _bkH_cnt_cur := 0
if not na(_prvH_now) and close > _prvH_now + _bkMinDist
    _bkH_cnt_prv += 1
else
    _bkH_cnt_prv := 0
if not na(_curL_now) and close < _curL_now - _bkMinDist
    _bkL_cnt_cur += 1
else
    _bkL_cnt_cur := 0
if not na(_prvL_now) and close < _prvL_now - _bkMinDist
    _bkL_cnt_prv += 1
else
    _bkL_cnt_prv := 0

// Debug labels (solo cuando i_backtesting activo) - muestran estado de contadores BK
if i_backtesting
    string _dH = "H cntCur=" + str.tostring(_bkH_cnt_cur) +
                 " cntPrv=" + str.tostring(_bkH_cnt_prv) +
                 "\nscCur=" + str.tostring(_scH_cur) +
                 " scPrv=" + str.tostring(_scH_prv) +
                 "\nclsCur=" + (not na(_curH_now) ? str.tostring(close - _curH_now, format.mintick) : "na") +
                 " clsPrv=" + (not na(_prvH_now) ? str.tostring(close - _prvH_now, format.mintick) : "na") +
                 "\ndist=" + str.tostring(_bkMinDist, format.mintick) +
                 "\nb2c=" + str.tostring(_b2H_cur) +
                 " b2p=" + str.tostring(_b2H_prv) +
                 " src=" + str.tostring(_bkH_src_b2)
    if na(_dbgH)
        _dbgH := label.new(bar_index, high + atrVal * 3, _dH,
                           style=label.style_label_down, color=color.new(color.blue, 70),
                           textcolor=color.white, size=size.normal)
    else
        label.set_x(_dbgH, bar_index)
        label.set_y(_dbgH, high + atrVal * 3)
        label.set_text(_dbgH, _dH)
    string _dL = "L cntCur=" + str.tostring(_bkL_cnt_cur) +
                 " cntPrv=" + str.tostring(_bkL_cnt_prv) +
                 "\nscCur=" + str.tostring(_scL_cur) +
                 " scPrv=" + str.tostring(_scL_prv) +
                 "\nclsCur=" + (not na(_curL_now) ? str.tostring(close - _curL_now, format.mintick) : "na") +
                 " clsPrv=" + (not na(_prvL_now) ? str.tostring(close - _prvL_now, format.mintick) : "na") +
                 "\ndist=" + str.tostring(_bkMinDist, format.mintick) +
                 "\nb2c=" + str.tostring(_b2L_cur) +
                 " b2p=" + str.tostring(_b2L_prv) +
                 " src=" + str.tostring(_bkL_src_b2)
    if na(_dbgL)
        _dbgL := label.new(bar_index, low - atrVal * 3, _dL,
                           style=label.style_label_up, color=color.new(color.purple, 70),
                           textcolor=color.white, size=size.normal)
    else
        label.set_x(_dbgL, bar_index)
        label.set_y(_dbgL, low - atrVal * 3)
        label.set_text(_dbgL, _dL)

// Bloque de rotacion BK inlineado (restriccion v6: no puede modificar vars globales en funcion)
// Break confirmado cuando el contador supera i_bkConfirmBars (>= para no depender del frame exacto)
// Guard de duplicados: si la BK candidata proyecta cerca de la BK actual, es la misma tendencia
float _candProj1B = f_proj(_b1H_cur, _v1H_cur, _b2H_cur, _v2H_cur)
float _candProj2B = f_proj(_b1H_prv, _v1H_prv, _b2H_prv, _v2H_prv)
float _candProj1A = f_proj(_b1L_cur, _v1L_cur, _b2L_cur, _v2L_cur)
float _candProj2A = f_proj(_b1L_prv, _v1L_prv, _b2L_prv, _v2L_prv)
float _curBKProj  = f_proj(_b1BK_cur, _v1BK_cur, _b2BK_cur, _v2BK_cur)
float _bkDupDist  = i_bkDupATR * atrVal
bool  _dup1B = i_bkDupATR > 0 and not na(_curBKProj) and not na(_candProj1B) and math.abs(_candProj1B - _curBKProj) < _bkDupDist
bool  _dup2B = i_bkDupATR > 0 and not na(_curBKProj) and not na(_candProj2B) and math.abs(_candProj2B - _curBKProj) < _bkDupDist
bool  _dup1A = i_bkDupATR > 0 and not na(_curBKProj) and not na(_candProj1A) and math.abs(_candProj1A - _curBKProj) < _bkDupDist
bool  _dup2A = i_bkDupATR > 0 and not na(_curBKProj) and not na(_candProj2A) and math.abs(_candProj2A - _curBKProj) < _bkDupDist

// Break de 1B (cur slot) - slot unico, BK vieja se elimina
if _bkH_cnt_cur >= i_bkConfirmBars and (na(_bkH_src_b2) or _b2H_cur != _bkH_src_b2) and _scH_cur >= i_bkMinTouches and not _dup1B
    _bkH_src_b2 := _b2H_cur
    line.delete(_tlBK_cur)
    label.delete(_lbl1BK)
    _b1BK_cur := _b1H_cur,  _v1BK_cur := _v1H_cur
    _b2BK_cur := _b2H_cur,  _v2BK_cur := _v2H_cur
    _scBK_cur := _scH_cur,  _bkFromH_cur := true,  _bkSlope_cur := _v2H_cur < _v1H_cur
    _tlBK_cur := line.new(_b1H_cur, _v1H_cur, _b2H_cur, _v2H_cur,
                          color=color.new(i_colBK, f_tlAlpha(_scH_cur)),
                          width=2, style=line.style_dashed, extend=extend.right)
    _lbl1BK := label.new(bar_index + 3, _v2H_cur, "1BK",
                         color=color.new(i_colBK, 70), textcolor=i_colBK,
                         style=label.style_label_left, size=size.small)
    // Label estatico en barra de confirmacion del break (1B rota al alza)
    label.new(bar_index, high + atrVal * 0.3, "BK 1B",
              style=label.style_label_down,
              color=color.new(i_colBK, 30), textcolor=color.white, size=size.tiny)
    _bk_judas_until := bar_index + i_bkJudasBars
    line.delete(_tlH_cur)
    label.delete(_lbl1B)
    _tlH_cur := na
    _lbl1B   := na
    _scH_cur := 0
    _bkH_cnt_cur := 0

// Break de 2B (prv slot) cuando 1B sigue intacta - slot unico, BK vieja se elimina
else if _bkH_cnt_prv >= i_bkConfirmBars and (na(_bkH_src_b2) or _b2H_prv != _bkH_src_b2) and _scH_prv >= i_bkMinTouches and not _dup2B
    _bkH_src_b2 := _b2H_prv
    line.delete(_tlBK_cur)
    label.delete(_lbl1BK)
    _b1BK_cur := _b1H_prv,  _v1BK_cur := _v1H_prv
    _b2BK_cur := _b2H_prv,  _v2BK_cur := _v2H_prv
    _scBK_cur := _scH_prv,  _bkFromH_cur := true,  _bkSlope_cur := _v2H_prv < _v1H_prv
    _tlBK_cur := line.new(_b1H_prv, _v1H_prv, _b2H_prv, _v2H_prv,
                          color=color.new(i_colBK, f_tlAlpha(_scH_prv)),
                          width=2, style=line.style_dashed, extend=extend.right)
    _lbl1BK := label.new(bar_index + 3, _v2H_prv, "1BK",
                         color=color.new(i_colBK, 70), textcolor=i_colBK,
                         style=label.style_label_left, size=size.small)
    // Label estatico en barra de confirmacion del break (2B rota al alza)
    label.new(bar_index, high + atrVal * 0.3, "BK 2B",
              style=label.style_label_down,
              color=color.new(i_colBK, 30), textcolor=color.white, size=size.tiny)
    _bk_judas_until := bar_index + i_bkJudasBars
    line.delete(_tlH_prv)
    label.delete(_lbl2B)
    _tlH_prv := na
    _lbl2B   := na
    _scH_prv := 0
    _bkH_cnt_prv := 0

// Break de 1A (cur slot) - slot unico, BK vieja se elimina
if _bkL_cnt_cur >= i_bkConfirmBars and (na(_bkL_src_b2) or _b2L_cur != _bkL_src_b2) and _scL_cur >= i_bkMinTouches and not _dup1A
    _bkL_src_b2 := _b2L_cur
    line.delete(_tlBK_cur)
    label.delete(_lbl1BK)
    _b1BK_cur := _b1L_cur,  _v1BK_cur := _v1L_cur
    _b2BK_cur := _b2L_cur,  _v2BK_cur := _v2L_cur
    _scBK_cur := _scL_cur,  _bkFromH_cur := false,  _bkSlope_cur := _v2L_cur > _v1L_cur
    _tlBK_cur := line.new(_b1L_cur, _v1L_cur, _b2L_cur, _v2L_cur,
                          color=color.new(i_colBK, f_tlAlpha(_scL_cur)),
                          width=2, style=line.style_dashed, extend=extend.right)
    _lbl1BK := label.new(bar_index + 3, _v2L_cur, "1BK",
                         color=color.new(i_colBK, 70), textcolor=i_colBK,
                         style=label.style_label_left, size=size.small)
    // Label estatico en barra de confirmacion del break (1A rota a la baja)
    label.new(bar_index, low - atrVal * 0.3, "BK 1A",
              style=label.style_label_up,
              color=color.new(i_colBK, 30), textcolor=color.white, size=size.tiny)
    _bk_judas_until := bar_index + i_bkJudasBars
    line.delete(_tlL_cur)
    label.delete(_lbl1A)
    _tlL_cur := na
    _lbl1A   := na
    _scL_cur := 0
    _bkL_cnt_cur := 0

// Break de 2A (prv slot) cuando 1A sigue intacta - slot unico, BK vieja se elimina
else if _bkL_cnt_prv >= i_bkConfirmBars and (na(_bkL_src_b2) or _b2L_prv != _bkL_src_b2) and _scL_prv >= i_bkMinTouches and not _dup2A
    _bkL_src_b2 := _b2L_prv
    line.delete(_tlBK_cur)
    label.delete(_lbl1BK)
    _b1BK_cur := _b1L_prv,  _v1BK_cur := _v1L_prv
    _b2BK_cur := _b2L_prv,  _v2BK_cur := _v2L_prv
    _scBK_cur := _scL_prv,  _bkFromH_cur := false,  _bkSlope_cur := _v2L_prv > _v1L_prv
    _tlBK_cur := line.new(_b1L_prv, _v1L_prv, _b2L_prv, _v2L_prv,
                          color=color.new(i_colBK, f_tlAlpha(_scL_prv)),
                          width=2, style=line.style_dashed, extend=extend.right)
    _lbl1BK := label.new(bar_index + 3, _v2L_prv, "1BK",
                         color=color.new(i_colBK, 70), textcolor=i_colBK,
                         style=label.style_label_left, size=size.small)
    // Label estatico en barra de confirmacion del break (2A rota a la baja)
    label.new(bar_index, low - atrVal * 0.3, "BK 2A",
              style=label.style_label_up,
              color=color.new(i_colBK, 30), textcolor=color.white, size=size.tiny)
    _bk_judas_until := bar_index + i_bkJudasBars
    line.delete(_tlL_prv)
    label.delete(_lbl2A)
    _tlL_prv := na
    _lbl2A   := na
    _scL_prv := 0
    _bkL_cnt_prv := 0

// =============================================================================
// JUDAS FILTER - invalida BK si dentro de la ventana de vigilancia el precio
// cierra de regreso al lado original de la TL rota. Restaura la TL al slot
// original (fiel a la realidad: si fue Judas, ese nivel sigue siendo valido).
// =============================================================================
if not na(_bk_judas_until) and bar_index <= _bk_judas_until and not na(_tlBK_cur)
    float _bkProj_now = f_proj(_b1BK_cur, _v1BK_cur, _b2BK_cur, _v2BK_cur)
    float _judasDist  = i_bkJudasATR * atrVal
    bool  _judasNow   = false
    if _bkFromH_cur and not na(_bkProj_now) and close < _bkProj_now - _judasDist
        _judasNow := true
    if not _bkFromH_cur and not na(_bkProj_now) and close > _bkProj_now + _judasDist
        _judasNow := true
    if _judasNow
        // Borrar BK (linea + label flotante 1BK)
        line.delete(_tlBK_cur)
        label.delete(_lbl1BK)
        _tlBK_cur := na
        _lbl1BK   := na
        // Restaurar TL original al slot apropiado (cur si esta libre, sino prv)
        if _bkFromH_cur
            if na(_tlH_cur)
                _b1H_cur := _b1BK_cur,  _v1H_cur := _v1BK_cur
                _b2H_cur := _b2BK_cur,  _v2H_cur := _v2BK_cur
                _scH_cur := _scBK_cur
                _bkH_cnt_cur := 0
                _tlH_cur := line.new(_b1H_cur, _v1H_cur, _b2H_cur, _v2H_cur,
                                      color=color.new(i_colH, f_tlAlpha(_scH_cur)),
                                      width=_scH_cur >= i_minTouches ? 2 : 1, extend=extend.right)
                _lbl1B := label.new(bar_index + 3, _v2H_cur, "1B",
                                     color=color.new(i_colH, 70), textcolor=i_colH,
                                     style=label.style_label_left, size=size.small)
            else
                line.delete(_tlH_prv)
                label.delete(_lbl2B)
                _b1H_prv := _b1BK_cur,  _v1H_prv := _v1BK_cur
                _b2H_prv := _b2BK_cur,  _v2H_prv := _v2BK_cur
                _scH_prv := _scBK_cur
                _bkH_cnt_prv := 0
                _tlH_prv := line.new(_b1H_prv, _v1H_prv, _b2H_prv, _v2H_prv,
                                      color=color.new(i_colH, 40),
                                      width=1, extend=extend.right)
                _lbl2B := label.new(bar_index + 3, _v2H_prv, "2B",
                                     color=color.new(i_colH, 85), textcolor=i_colH,
                                     style=label.style_label_left, size=size.small)
            _bkH_src_b2 := int(na)
            // Label JUDAS abajo (precio retorno por debajo de BK)
            label.new(bar_index, low - atrVal * 0.3, "JUDAS",
                      style=label.style_label_up,
                      color=color.new(color.yellow, 20), textcolor=color.black, size=size.small)
        else
            if na(_tlL_cur)
                _b1L_cur := _b1BK_cur,  _v1L_cur := _v1BK_cur
                _b2L_cur := _b2BK_cur,  _v2L_cur := _v2BK_cur
                _scL_cur := _scBK_cur
                _bkL_cnt_cur := 0
                _tlL_cur := line.new(_b1L_cur, _v1L_cur, _b2L_cur, _v2L_cur,
                                      color=color.new(i_colL, f_tlAlpha(_scL_cur)),
                                      width=_scL_cur >= i_minTouches ? 2 : 1, extend=extend.right)
                _lbl1A := label.new(bar_index + 3, _v2L_cur, "1A",
                                     color=color.new(i_colL, 70), textcolor=i_colL,
                                     style=label.style_label_left, size=size.small)
            else
                line.delete(_tlL_prv)
                label.delete(_lbl2A)
                _b1L_prv := _b1BK_cur,  _v1L_prv := _v1BK_cur
                _b2L_prv := _b2BK_cur,  _v2L_prv := _v2BK_cur
                _scL_prv := _scBK_cur
                _bkL_cnt_prv := 0
                _tlL_prv := line.new(_b1L_prv, _v1L_prv, _b2L_prv, _v2L_prv,
                                      color=color.new(i_colL, 40),
                                      width=1, extend=extend.right)
                _lbl2A := label.new(bar_index + 3, _v2L_prv, "2A",
                                     color=color.new(i_colL, 85), textcolor=i_colL,
                                     style=label.style_label_left, size=size.small)
            _bkL_src_b2 := int(na)
            // Label JUDAS arriba (precio retorno por encima de BK)
            label.new(bar_index, high + atrVal * 0.3, "JUDAS",
                      style=label.style_label_down,
                      color=color.new(color.yellow, 20), textcolor=color.black, size=size.small)
        // Limpiar estado BK
        _b1BK_cur := int(na),    _v1BK_cur := float(na)
        _b2BK_cur := int(na),    _v2BK_cur := float(na)
        _scBK_cur := 0
        _bk_judas_until := int(na)

// =============================================================================
// SENALES: wick de rechazo contra la trendline proyectada al bar actual
// La trendline debe tener al menos i_minTouches pivotes confirmados.
// Entrada inmediata en el close del bar de rechazo.
// =============================================================================
float _range  = high - low
float _upWick = high - math.max(open, close)
float _dnWick = math.min(open, close) - low

f_bearRej(float lvl) =>
    (not na(lvl) and _range > 0
    and high >= lvl - _tol
    and high <= lvl + _tol * 1.5
    and close[1] < lvl - _tol * 0.3
    and _upWick / _range >= i_wickRatio)

f_bullRej(float lvl) =>
    (not na(lvl) and _range > 0
    and low <= lvl + _tol
    and low >= lvl - _tol * 1.5
    and close[1] > lvl + _tol * 0.3
    and _dnWick / _range >= i_wickRatio)

// _tradeOpen se lee al inicio del bar (antes de cualquier cierre).
// Garantiza que en el bar donde SL/TP es tocado NO se abre un nuevo trade.
var bool  _tradeOpen = false

int _bearScore = f_scoreBear(tlH_now)
int _bullScore = f_scoreBull(tlL_now)

bool bearSig = (f_bearRej(tlH_now)
    and _tlH_score >= i_minTouches
    and _bearScore >= i_minScore
    and not _tradeOpen
    and _sesOK and _inTradeHours)

bool bullSig = (f_bullRej(tlL_now)
    and _tlL_score >= i_minTouches
    and _bullScore >= i_minScore
    and not _tradeOpen
    and _sesOK and _inTradeHours)

// Senales BK: retest de TL rota (role reversal)
// Filtro de consolidacion: pendiente primero (opcion 2), spread ATR como fallback (opcion 1)
float _baSpread = not na(tlH_now) and not na(tlL_now) ? math.abs(tlH_now - tlL_now) : float(na)
_tlBK_score := not na(_bkCurNow) ? _scBK_cur : (not na(_bkPrvNow) ? _scBK_prv : 0)
float tlBK_now = not na(_bkCurNow) ? _bkCurNow : (not na(_bkPrvNow) ? _bkPrvNow : float(na))
bool  _bkIsH   = not na(_bkCurNow) ? _bkFromH_cur : _bkFromH_prv
bool  _bkSlope = not na(_bkCurNow) ? _bkSlope_cur  : _bkSlope_prv
bool  _bkFilter = _bkSlope or (not na(_baSpread) and _baSpread > i_minSpreadATR * atrVal)

bool bkBullSig = (not na(tlBK_now) and _bkIsH
    and f_bullRej(tlBK_now)
    and _bkFilter
    and not _tradeOpen
    and _sesOK and _inTradeHours)

bool bkBearSig = (not na(tlBK_now) and not _bkIsH
    and f_bearRej(tlBK_now)
    and _bkFilter
    and not _tradeOpen
    and _sesOK and _inTradeHours)

plotshape(bearSig,   "SHORT entrada",    location=location.abovebar,
          color=i_colH,  style=shape.triangledown, size=size.small)
plotshape(bullSig,   "LONG entrada",     location=location.belowbar,
          color=i_colL,  style=shape.triangleup,   size=size.small)
plotshape(bkBearSig, "SHORT-BK entrada", location=location.abovebar,
          color=i_colBK, style=shape.triangledown, size=size.tiny)
plotshape(bkBullSig, "LONG-BK entrada",  location=location.belowbar,
          color=i_colBK, style=shape.triangleup,   size=size.tiny)

// =============================================================================
// ENTRADAS + CAJAS R/R (siempre visibles, patron acc-scalping)
// =============================================================================
var bool  trActive = false
var box   trRisk   = na
var box   trProfit = na
var int   nClosed  = 0
var float trSL     = float(na)
var float trTP     = float(na)
var bool  trLong   = false

if trActive
    bool _hitSL = trLong ? low  <= trSL : high >= trSL
    bool _hitTP = trLong ? high >= trTP : low  <= trTP
    if _hitSL or _hitTP or strategy.closedtrades > nClosed
        trActive   := false
        _tradeOpen := false
        nClosed    := strategy.closedtrades
    else
        box.set_right(trRisk,   bar_index)
        box.set_right(trProfit, bar_index)

if bearSig
    float _sl     = high + atrVal * i_slBuf
    float _e      = close
    float _slDist = _sl - _e
    float _qty    = i_riskUSD / _slDist
    float _tp2    = _e - _slDist * 2
    float _tp3    = _e - _slDist * 3
    string _ses   = _inLD ? "LD" : (_inNY ? "NY" : "---")
    trRisk   := box.new(bar_index, _sl, bar_index + 1, _e,
                        border_color=color.red,  bgcolor=color.new(color.red,  80))
    trProfit := box.new(bar_index, _e,  bar_index + 1, _tp2,
                        border_color=color.teal, bgcolor=color.new(color.teal, 80))
    trActive   := true
    _tradeOpen := true
    trSL       := _sl
    trTP       := _tp2
    trLong     := false
    [_ptS, _pcS] = f_prob(_bearScore)
    label _probLblS = label.new(bar_index, _sl + atrVal * 0.6,
                    "[" + _ptS + "  " + str.tostring(_bearScore) + "]",
                    style=label.style_label_down,
                    color=color.new(_pcS, 30), textcolor=color.white, size=size.tiny)
    line _slLineS  = line.new(bar_index, _sl,  bar_index + 4,  _sl,
                    color=color.new(color.red, 50), width=1)
    line _tp2LineS = line.new(bar_index, _tp2, bar_index + 25, _tp2,
                    color=color.new(#26A69A, 40), width=2)
    label _tp2LblS = label.new(bar_index + 25, _tp2,
                    "TP 1:2  $" + str.tostring(math.round(i_riskUSD * 2)),
                    style=label.style_label_left,
                    color=color.new(#26A69A, 45), textcolor=color.white, size=size.tiny)
    line _tp3LineS = line.new(bar_index, _tp3, bar_index + 38, _tp3,
                    color=color.new(#26A69A, 65), width=1, style=line.style_dashed)
    label _tp3LblS = label.new(bar_index + 38, _tp3,
                    "TP 1:3  $" + str.tostring(math.round(i_riskUSD * 3)),
                    style=label.style_label_left,
                    color=color.new(#26A69A, 65), textcolor=color.white, size=size.tiny)
    if i_backtesting
        label _lbl = label.new(bar_index, _sl + atrVal * 0.3,
                      "SHORT  Ses: " + _ses +
                      "\nE: "   + str.tostring(_e,  format.mintick) +
                      "  SL: " + str.tostring(_sl, format.mintick) +
                      "\nRiesgo: $"  + str.tostring(math.round(i_riskUSD)) +
                      "  Profit 1:2: $" + str.tostring(math.round(i_riskUSD * 2)),
                      style=label.style_label_down,
                      color=color.new(i_colH, 10), textcolor=color.white, size=size.small)
    strategy.entry("SHORT", strategy.short, qty=_qty)
    strategy.exit("SHORT-X", "SHORT", stop=_sl, limit=_tp2)

if bullSig
    float _sl     = low - atrVal * i_slBuf
    float _e      = close
    float _slDist = _e - _sl
    float _qty    = i_riskUSD / _slDist
    float _tp2    = _e + _slDist * 2
    float _tp3    = _e + _slDist * 3
    string _ses   = _inLD ? "LD" : (_inNY ? "NY" : "---")
    trRisk   := box.new(bar_index, _e,   bar_index + 1, _sl,
                        border_color=color.red,  bgcolor=color.new(color.red,  80))
    trProfit := box.new(bar_index, _tp2, bar_index + 1, _e,
                        border_color=color.teal, bgcolor=color.new(color.teal, 80))
    trActive   := true
    _tradeOpen := true
    trSL       := _sl
    trTP       := _tp2
    trLong     := true
    [_ptL, _pcL] = f_prob(_bullScore)
    label _probLblL = label.new(bar_index, _sl - atrVal * 0.6,
                    "[" + _ptL + "  " + str.tostring(_bullScore) + "]",
                    style=label.style_label_up,
                    color=color.new(_pcL, 30), textcolor=color.white, size=size.tiny)
    line _slLineL  = line.new(bar_index, _sl,  bar_index + 4,  _sl,
                    color=color.new(color.red, 50), width=1)
    line _tp2LineL = line.new(bar_index, _tp2, bar_index + 25, _tp2,
                    color=color.new(#26A69A, 40), width=2)
    label _tp2LblL = label.new(bar_index + 25, _tp2,
                    "TP 1:2  $" + str.tostring(math.round(i_riskUSD * 2)),
                    style=label.style_label_left,
                    color=color.new(#26A69A, 45), textcolor=color.white, size=size.tiny)
    line _tp3LineL = line.new(bar_index, _tp3, bar_index + 38, _tp3,
                    color=color.new(#26A69A, 65), width=1, style=line.style_dashed)
    label _tp3LblL = label.new(bar_index + 38, _tp3,
                    "TP 1:3  $" + str.tostring(math.round(i_riskUSD * 3)),
                    style=label.style_label_left,
                    color=color.new(#26A69A, 65), textcolor=color.white, size=size.tiny)
    if i_backtesting
        label _lbl = label.new(bar_index, _sl - atrVal * 0.3,
                      "LONG   Ses: " + _ses +
                      "\nE: "   + str.tostring(_e,  format.mintick) +
                      "  SL: " + str.tostring(_sl, format.mintick) +
                      "\nRiesgo: $"  + str.tostring(math.round(i_riskUSD)) +
                      "  Profit 1:2: $" + str.tostring(math.round(i_riskUSD * 2)),
                      style=label.style_label_up,
                      color=color.new(i_colL, 10), textcolor=color.white, size=size.small)
    strategy.entry("LONG", strategy.long, qty=_qty)
    strategy.exit("LONG-X", "LONG", stop=_sl, limit=_tp2)

if bkBearSig
    float _sl     = high + atrVal * i_slBuf
    float _e      = close
    float _slDist = _sl - _e
    float _qty    = i_riskUSD / _slDist
    float _tp2    = _e - _slDist * 2
    float _tp3    = _e - _slDist * 3
    string _ses   = _inLD ? "LD" : (_inNY ? "NY" : "---")
    trRisk   := box.new(bar_index, _sl, bar_index + 1, _e,
                        border_color=i_colBK, bgcolor=color.new(i_colBK, 80))
    trProfit := box.new(bar_index, _e,  bar_index + 1, _tp2,
                        border_color=color.teal, bgcolor=color.new(color.teal, 80))
    trActive   := true
    _tradeOpen := true
    trSL       := _sl
    trTP       := _tp2
    trLong     := false
    line _slLineBK  = line.new(bar_index, _sl,  bar_index + 4,  _sl,
                    color=color.new(color.red, 50), width=1)
    line _tp2LineBK = line.new(bar_index, _tp2, bar_index + 25, _tp2,
                    color=color.new(#26A69A, 40), width=2)
    if i_backtesting
        label.new(bar_index, _sl + atrVal * 0.3,
                  "SHORT-BK  Ses: " + _ses +
                  "\nE: "   + str.tostring(_e,  format.mintick) +
                  "  SL: " + str.tostring(_sl, format.mintick),
                  style=label.style_label_down,
                  color=color.new(i_colBK, 10), textcolor=color.white, size=size.small)
    strategy.entry("SHORT-BK", strategy.short, qty=_qty)
    strategy.exit("SHORT-BK-X", "SHORT-BK", stop=_sl, limit=_tp2)

if bkBullSig
    float _sl     = low - atrVal * i_slBuf
    float _e      = close
    float _slDist = _e - _sl
    float _qty    = i_riskUSD / _slDist
    float _tp2    = _e + _slDist * 2
    float _tp3    = _e + _slDist * 3
    string _ses   = _inLD ? "LD" : (_inNY ? "NY" : "---")
    trRisk   := box.new(bar_index, _e,   bar_index + 1, _sl,
                        border_color=i_colBK, bgcolor=color.new(i_colBK, 80))
    trProfit := box.new(bar_index, _tp2, bar_index + 1, _e,
                        border_color=color.teal, bgcolor=color.new(color.teal, 80))
    trActive   := true
    _tradeOpen := true
    trSL       := _sl
    trTP       := _tp2
    trLong     := true
    line _slLineBKL  = line.new(bar_index, _sl,  bar_index + 4,  _sl,
                     color=color.new(color.red, 50), width=1)
    line _tp2LineBKL = line.new(bar_index, _tp2, bar_index + 25, _tp2,
                     color=color.new(#26A69A, 40), width=2)
    if i_backtesting
        label.new(bar_index, _sl - atrVal * 0.3,
                  "LONG-BK   Ses: " + _ses +
                  "\nE: "   + str.tostring(_e,  format.mintick) +
                  "  SL: " + str.tostring(_sl, format.mintick),
                  style=label.style_label_up,
                  color=color.new(i_colBK, 10), textcolor=color.white, size=size.small)
    strategy.entry("LONG-BK", strategy.long, qty=_qty)
    strategy.exit("LONG-BK-X", "LONG-BK", stop=_sl, limit=_tp2)

// =============================================================================
// ALERTAS
// =============================================================================
alertcondition(bearSig,   "SHORT    - Pivote en TL resistencia",
               "Pivote alto confirmado sobre trendline de resistencia.")
alertcondition(bullSig,   "LONG     - Pivote en TL soporte",
               "Pivote bajo confirmado sobre trendline de soporte.")
alertcondition(bkBearSig, "SHORT-BK - Retest de B rota como resistencia",
               "Precio retestea desde arriba una trendline bajista que fue rota al alza.")
alertcondition(bkBullSig, "LONG-BK  - Retest de A rota como soporte",
               "Precio retestea desde abajo una trendline alcista que fue rota a la baja.")
